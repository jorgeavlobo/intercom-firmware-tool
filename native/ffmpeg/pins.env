# Pinned build inputs for the vendored minimal ffmpeg (issue #120) — the SINGLE source of
# truth, loaded by BOTH .github/workflows/ffmpeg-build.yml (produces the committed binary)
# and .github/workflows/ffmpeg-provenance.yml (independently rebuilds + byte-compares), so a
# pin can never drift between them. This file is under native/ffmpeg/**, which is in the
# provenance path filter, so changing a pin re-runs the byte-for-byte check against the
# committed binary. Bump deliberately (and refresh the binary via ffmpeg-build.yml).
#
# Loaded with: grep -E '^[A-Za-z_][A-Za-z0-9_]*=' native/ffmpeg/pins.env >> "$GITHUB_ENV"
# (the grep skips these comment lines, which are not valid GITHUB_ENV entries).
#
# ZIG_SHA256 is Zig's published, immutable release digest for zig-linux-x86_64-0.13.0.tar.xz.
# FFMPEG_TARBALL_SHA256 is the GitHub source archive for tag n7.1.1; if GitHub ever changes
# an archive checksum the job fails loudly rather than accepting new bytes.
ZIG_VERSION=0.13.0
ZIG_SHA256=d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea
FFMPEG_TAG=n7.1.1
FFMPEG_TARBALL_SHA256=f117507dc501f2a6c11f9241d8d0c3213846cfad91764361af37befd6b6c523d
SOURCE_DATE_EPOCH=1700000000
