# Pinned upstream release for the vendored go2rtc binary (issue #120) — the SINGLE source of
# truth, loaded by .github/workflows/go2rtc-provenance.yml, which re-downloads the pinned release
# asset and byte-compares it to the committed binary. go2rtc is a THIRD-PARTY prebuilt (a
# statically-linked Go release binary, MIT); unlike ffmpeg/btmqttd it is NOT rebuilt from source
# here, so the provenance model is PIN-AND-VERIFY: pin the exact release tag + asset + SHA-256, and
# CI re-fetches that exact asset and proves it is byte-identical to the committed copy.
#
# Loaded with: grep -E '^[A-Za-z_][A-Za-z0-9_]*=' native/go2rtc/pins.env >> "$GITHUB_ENV"
# (the grep skips these comment lines, which are not valid GITHUB_ENV entries).
#
# Bump deliberately: update GO2RTC_TAG + GO2RTC_SHA256 + GO2RTC_SIZE together, refresh the committed
# binary (IntercomFirmwareTool.Core/Payload/vendor/armhf/go2rtc) and its size/SHA in
# PayloadBinaries.cs and Payload/vendor/THIRD_PARTY.md, and the version string in this repo's docs.
GO2RTC_TAG=v1.9.14
GO2RTC_ASSET=go2rtc_linux_arm
# The upstream release download URL is derived as:
#   https://github.com/AlexxIT/go2rtc/releases/download/${GO2RTC_TAG}/${GO2RTC_ASSET}
GO2RTC_SHA256=4d7e1639af5a2722a28e864468fd8099b3c1682565446c798bf9e3b38fde12e4
GO2RTC_SIZE=4588084
