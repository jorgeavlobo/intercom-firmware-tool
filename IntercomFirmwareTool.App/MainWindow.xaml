<Window x:Class="IntercomFirmwareTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntercomFirmwareTool.App"
        mc:Ignorable="d"
        Title="Intercom Firmware Tool — SSH-enable (Classe 100X / 300X)"
        Icon="Assets/Icons/AppIcon.ico"
        Height="760" Width="880" MinHeight="690" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="Button" x:Key="BrowseButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Small flat icon button (Segoe MDL2 Assets glyphs) for the inline
             password actions: reveal, copy, generate. -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFBFBFBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Larger icon button for the form rows (Browse / choose / generate).
             Left-aligned so the first button of every row lines up vertically. -->
        <Style TargetType="Button" x:Key="RowIconButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="6,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Uniform data-entry field: same height everywhere. -->
        <Style TargetType="TextBox" x:Key="InputField">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- Rounded, brand-coloured button for the "buy me a coffee" links.
             Background/Foreground are set per-button to each brand's colour. -->
        <Style TargetType="Button" x:Key="DonateButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <!-- Symmetric horizontal margin: in the UniformGrid this keeps an even
                 gap between the buttons AND equal padding on the block's outer edges. -->
            <Setter Property="Margin" Value="4,0,4,0"/>
            <!-- Equal height (fixed) restored to the original taller size; equal
                 WIDTH comes from the UniformGrid host, which sizes both cells to the
                 wider button — so neither is forced wider than its natural size. -->
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Constant 2px transparent border so the keyboard-focus ring
                             (below) appears without shifting the layout. ClipToBounds
                             keeps the shine sweep inside the button. -->
                        <Border x:Name="pill" Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Shine: a soft, skewed light band parked off the left
                                     edge; the code-behind sweeps sheenT across at random
                                     intervals (independently per button) for a subtle glint. -->
                                <Border x:Name="sheen" Width="46" HorizontalAlignment="Left"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#4DFFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-18"/>
                                            <TranslateTransform x:Name="sheenT" X="-90"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#CCFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pill" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brand icons, transcoded from Assets/Icons/PayPal.svg and Revolut.svg
             into native WPF vectors (WPF can't render .svg directly; this keeps
             the app dependency-free). The .svg files remain the design source. -->
        <DrawingImage x:Key="PayPalIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#002991" Geometry="F1 M38.914 13.35c0 5.574-5.144 12.15-12.927 12.15H18.49l-.368 2.322L16.373 39H7.056l5.605-36h15.095c5.083 0 9.082 2.833 10.555 6.77a9.687 9.687 0 0 1 .603 3.58z"/>
                    <GeometryDrawing Brush="#60CDFF" Geometry="F1 M44.284 23.7A12.894 12.894 0 0 1 31.53 34.5h-5.206L24.157 48H14.89l1.483-9 1.75-11.178.367-2.322h7.497c7.773 0 12.927-6.576 12.927-12.15 3.825 1.974 6.055 5.963 5.37 10.35z"/>
                    <GeometryDrawing Brush="#008CFF" Geometry="F1 M38.914 13.35C37.31 12.511 35.365 12 33.248 12h-12.64L18.49 25.5h7.497c7.773 0 12.927-6.576 12.927-12.15z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="RevolutIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#000000" Geometry="F1 M209.051 262.097h101.445v410.21H209.051z"/>
                    <GeometryDrawing Brush="#000000" Geometry="F1 M628.623 285.554c0-87.043-70.882-157.86-158.011-157.86H209.051v87.603h249.125c39.43 0 72.093 30.978 72.814 69.051 0.361 19.064-6.794 37.056-20.146 50.66-13.357 13.61-31.204 21.109-50.251 21.109h-97.046c-3.446 0-6.25 2.8-6.25 6.245v77.859c0 1.324 0.409 2.59 1.179 3.656l164.655 228.43h120.53L478.623 443.253C561.736 439.08 628.623 369.248 628.623 285.554z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: intro + safety -->
            <RowDefinition Height="Auto"/>   <!-- 1: input form -->
            <RowDefinition Height="Auto"/>   <!-- 2: action buttons -->
            <RowDefinition Height="Auto"/>   <!-- 3: result label -->
            <RowDefinition Height="*"/>      <!-- 4: result box -->
            <RowDefinition Height="Auto"/>   <!-- 5: diagnostics status -->
            <RowDefinition Height="Auto"/>   <!-- 6: support / buy me a coffee -->
        </Grid.RowDefinitions>

        <!-- Row 0: what this does + safety note -->
        <Border Grid.Row="0" Background="#FFF7F2E8" BorderBrush="#FFE0C98A"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="#FF7A5B00"><Run Text="⚠ Flashing modified firmware can brick the device. "/><Run Text="Do it at your own risk!" FontWeight="Bold" TextDecorations="Underline"/><Run Text=" Use "/><Hyperlink NavigateUri="https://assets.legrand.com/pim/AUTRE/MyHOME_Suite_030538.exe" RequestNavigate="Hyperlink_RequestNavigate">MyHOME Suite</Hyperlink><Run Text="."/></TextBlock>
        </Border>

        <!-- Row 1: the input form -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Firmware .fwz -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Firmware (.fwz):"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFwzPath"
                     Style="{StaticResource InputField}" IsReadOnly="True" Margin="0,0,0,6"
                     Text="(choose the original .fwz to modify)" Foreground="Gray"/>
            <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseFwz"
                    Style="{StaticResource RowIconButton}" Content="&#xE8B7;"
                    ToolTip="Browse for the original firmware (.fwz)…"
                    AutomationProperties.Name="Browse for the original firmware"
                    Click="BtnBrowseFwz_Click"/>

            <!-- Root password (masked) + reveal toggle + Disable (key-only). One of
                 the password or the key is required; ticking Disable turns password
                 login off, so a key becomes the credential. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Root password:"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="TxtPassword" Width="170" Style="{StaticResource InputField}"
                         FontFamily="Consolas"/>
                <!-- Inline actions, in order: generate, reveal (hold-to-show eye),
                     copy. Reveal affects BOTH the password and confirm fields. -->
                <Button x:Name="BtnRandomPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8B1;" ToolTip="Generate a strong random password"
                        AutomationProperties.Name="Generate a strong random password"
                        Click="BtnRandomPwd_Click"/>
                <Button x:Name="BtnToggleReveal" Style="{StaticResource IconButton}"
                        Content="&#xE7B3;" ToolTip="Hold to show the password"
                        AutomationProperties.Name="Hold to show the password"/>
                <Button x:Name="BtnCopyPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8C8;" ToolTip="Copy password to clipboard"
                        AutomationProperties.Name="Copy password to clipboard"
                        Click="BtnCopyPwd_Click"/>
                <CheckBox x:Name="ChkKeyOnly" VerticalAlignment="Center" Margin="16,0,0,0"
                          Content="Disable"
                          ToolTip="Disable password login (key-only) — requires an SSH key"
                          Checked="ChkKeyOnly_Toggled" Unchecked="ChkKeyOnly_Toggled"/>
            </StackPanel>

            <!-- Confirm password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Confirm password:"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="TxtConfirm" Width="170" Style="{StaticResource InputField}"
                         FontFamily="Consolas"/>
                <TextBlock x:Name="TxtPwdHint" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray"/>
            </StackPanel>

            <!-- SSH public key: OPTIONAL — choose an existing one or generate a
                 new pair. Without a key, login is by the root password above. -->
            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LblKey"
                       Style="{StaticResource FieldLabel}"
                       Text="SSH public key (optional):"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtKeyPath"
                     Style="{StaticResource InputField}" IsReadOnly="True" Margin="0,0,0,6"
                     Text="(optional: choose an existing .pub key, or generate a new pair)" Foreground="Gray"/>
            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnChooseKey" Style="{StaticResource RowIconButton}"
                        Content="&#xE8B7;" ToolTip="Choose an existing public key (.pub)…"
                        AutomationProperties.Name="Choose an existing public key"
                        Click="BtnChooseKey_Click"/>
                <Button x:Name="BtnGenKey" Style="{StaticResource RowIconButton}"
                        Content="&#xE192;" ToolTip="Generate a new SSH key pair…"
                        AutomationProperties.Name="Generate a new SSH key pair"
                        Click="BtnGenKey_Click"/>
                <Button x:Name="BtnClearKey" Style="{StaticResource RowIconButton}"
                        Content="&#xE711;" ToolTip="Clear the selected key (build with password only)"
                        AutomationProperties.Name="Clear the selected SSH key"
                        Click="BtnClearKey_Click"/>
            </StackPanel>

            <!-- Output (disabled until a firmware is chosen) -->
            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblOutput" IsEnabled="False"
                       Style="{StaticResource FieldLabel}" Text="Save output as:"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtOutputPath"
                     Style="{StaticResource InputField}" IsReadOnly="True" IsEnabled="False"
                     Text="(where to write the modified .fwz)" Foreground="Gray"/>
            <Button Grid.Row="4" Grid.Column="2" x:Name="BtnBrowseOutput"
                    Style="{StaticResource RowIconButton}" IsEnabled="False"
                    Content="&#xE74E;" ToolTip="Choose where to save the modified .fwz…"
                    AutomationProperties.Name="Choose where to save the modified firmware"
                    Click="BtnBrowseOutput_Click"/>
        </Grid>

        <!-- Row 2: actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnBuild" Padding="16,8" Margin="0,0,10,0"
                    FontWeight="SemiBold" IsEnabled="False"
                    Content="Build modified firmware" Click="BtnBuild_Click"/>
            <Button x:Name="BtnVerify" Padding="12,8" Margin="0,0,10,0"
                    Content="Inspect an existing .fwz…" Click="BtnVerify_Click"/>
            <Button x:Name="BtnSelfTest" Padding="12,8"
                    Content="Self-test (MD5-crypt)" Click="BtnSelfTest_Click"/>
        </StackPanel>

        <!-- Row 3: result label -->
        <TextBlock Grid.Row="3" Text="Result:" Margin="0,0,0,4" FontWeight="SemiBold"/>

        <!-- Row 4: result box -->
        <TextBox x:Name="TxtResult" Grid.Row="4"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="Choose a firmware and an output path, set a root password and/or an SSH key (at least one), then click Build."/>

        <!-- Row 5: diagnostics -->
        <TextBlock Grid.Row="5" x:Name="TxtDiag" Margin="0,8,0,0"
                   Foreground="Gray" FontFamily="Consolas" FontSize="11"/>

        <!-- Row 6: support / buy me a coffee -->
        <Border Grid.Row="6" Margin="0,10,0,0" Padding="12,9"
                Background="#FFFBF7EF" BorderBrush="#FFE6D6AE" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DockPanel (not a horizontal StackPanel) so the message TextBlock is
                     measured with a constrained width and actually wraps instead of
                     overflowing and pushing the buttons off-screen at small widths. -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#x2615;" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF5B4A1E">
                        <Run Text="Found this tool useful? "/><Run Text="Buy me a coffee" FontWeight="SemiBold"/><Run Text=". Thank you! ☺"/>
                    </TextBlock>
                </DockPanel>

                <!-- UniformGrid: both cells take the width of the WIDER button, so
                     PayPal and Revolut end up equal without forcing an arbitrary width. -->
                <UniformGrid Grid.Column="1" Rows="1" Columns="2" VerticalAlignment="Center">
                    <!-- PayPal -->
                    <Button x:Name="BtnPayPal" Style="{StaticResource DonateButton}"
                            Background="#FF003087" Click="BtnPayPal_Click"
                            ToolTip="Support via PayPal"
                            AutomationProperties.Name="Buy me a coffee via PayPal">
                        <StackPanel Orientation="Horizontal">
                            <!-- Brand icon on a white chip (the multi-blue PayPal mark
                                 would be unreadable directly on the blue button). -->
                            <Border x:Name="IcoPayPal" Width="24" Height="24" CornerRadius="5"
                                    Background="White" Padding="3" Margin="0,0,7,0">
                                <Image Source="{StaticResource PayPalIcon}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="PayPal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Revolut -->
                    <Button x:Name="BtnRevolut" Style="{StaticResource DonateButton}"
                            Background="#FF191C1F" Click="BtnRevolut_Click"
                            ToolTip="Support via Revolut"
                            AutomationProperties.Name="Buy me a coffee via Revolut">
                        <StackPanel Orientation="Horizontal">
                            <!-- Brand icon on a white chip (the dark Revolut mark would
                                 be unreadable directly on the near-black button). -->
                            <Border x:Name="IcoRevolut" Width="24" Height="24" CornerRadius="5"
                                    Background="White" Padding="4" Margin="0,0,7,0">
                                <Image Source="{StaticResource RevolutIcon}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Revolut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
