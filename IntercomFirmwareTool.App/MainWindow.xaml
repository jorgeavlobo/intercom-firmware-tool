<Window x:Class="IntercomFirmwareTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntercomFirmwareTool.App"
        mc:Ignorable="d"
        Title="Intercom Firmware Tool — SSH-enable (Classe 100X / 300X)"
        Height="700" Width="880" MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Button" x:Key="BrowseButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Small flat icon button (Segoe MDL2 Assets glyphs) for the inline
             password actions: reveal, copy, generate. -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFBFBFBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: intro + safety -->
            <RowDefinition Height="Auto"/>   <!-- 1: input form -->
            <RowDefinition Height="Auto"/>   <!-- 2: action buttons -->
            <RowDefinition Height="Auto"/>   <!-- 3: result label -->
            <RowDefinition Height="*"/>      <!-- 4: result box -->
            <RowDefinition Height="Auto"/>   <!-- 5: diagnostics status -->
        </Grid.RowDefinitions>

        <!-- Row 0: what this does + safety note -->
        <Border Grid.Row="0" Background="#FFF7F2E8" BorderBrush="#FFE0C98A"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="Builds a modified BTicino firmware (.fwz) that enables SSH/root login, replicating the fquinto project on Windows."/>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF7A5B00"
                           Text="⚠ Flashing modified firmware can brick a device. Keep USB/SAM-BA recovery ready before you flash. Your input .fwz is never modified — a new file is written."/>
            </StackPanel>
        </Border>

        <!-- Row 1: the input form -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Firmware .fwz -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Firmware (.fwz):"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFwzPath" IsReadOnly="True"
                     VerticalContentAlignment="Center" Padding="4,3" Margin="0,0,0,6"
                     Text="(choose the original .fwz to modify)" Foreground="Gray"/>
            <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseFwz"
                    Style="{StaticResource BrowseButton}" Margin="8,0,0,6"
                    Content="Browse…" Click="BtnBrowseFwz_Click"/>

            <!-- SSH public key: choose an existing one or generate a new pair -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="SSH public key:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtKeyPath" IsReadOnly="True"
                     VerticalContentAlignment="Center" Padding="4,3" Margin="0,0,0,6"
                     Text="(choose an existing .pub key, or generate a new pair)" Foreground="Gray"/>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,6">
                <Button x:Name="BtnChooseKey" Padding="10,4" MinWidth="110"
                        Content="Choose existing…" Click="BtnChooseKey_Click"/>
                <Button x:Name="BtnGenKey" Padding="10,4" MinWidth="110" Margin="6,0,0,0"
                        Content="Generate new…" Click="BtnGenKey_Click"/>
            </StackPanel>

            <!-- Root password (masked) + reveal toggle + key-only -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Root password:"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="TxtPassword" Width="220" Padding="4,3"
                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                <!-- Inline actions: reveal (eye), copy, generate. Toggling reveal
                     affects BOTH the password and confirm fields. -->
                <Button x:Name="BtnToggleReveal" Style="{StaticResource IconButton}"
                        Content="&#xE7B3;" ToolTip="Show password"
                        Click="BtnToggleReveal_Click"/>
                <Button x:Name="BtnCopyPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8C8;" ToolTip="Copy password to clipboard"
                        Click="BtnCopyPwd_Click"/>
                <Button x:Name="BtnRandomPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8B1;" ToolTip="Generate a strong random password"
                        Click="BtnRandomPwd_Click"/>
                <CheckBox x:Name="ChkKeyOnly" VerticalAlignment="Center" Margin="16,0,0,0"
                          Content="Key-only login (no password)"
                          Checked="ChkKeyOnly_Toggled" Unchecked="ChkKeyOnly_Toggled"/>
            </StackPanel>

            <!-- Confirm password -->
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="Confirm password:"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="TxtConfirm" Width="200" Padding="4,3"
                         FontFamily="Consolas" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="TxtPwdHint" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray"/>
            </StackPanel>

            <!-- Output (disabled until a firmware is chosen) -->
            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblOutput" IsEnabled="False"
                       Style="{StaticResource FieldLabel}" Text="Save output as:"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtOutputPath" IsReadOnly="True"
                     IsEnabled="False"
                     VerticalContentAlignment="Center" Padding="4,3"
                     Text="(where to write the modified .fwz)" Foreground="Gray"/>
            <Button Grid.Row="4" Grid.Column="2" x:Name="BtnBrowseOutput"
                    Style="{StaticResource BrowseButton}" IsEnabled="False"
                    Content="Browse…" Click="BtnBrowseOutput_Click"/>
        </Grid>

        <!-- Row 2: actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnBuild" Padding="16,8" Margin="0,0,10,0"
                    FontWeight="SemiBold" IsEnabled="False"
                    Content="Build modified firmware" Click="BtnBuild_Click"/>
            <Button x:Name="BtnVerify" Padding="12,8" Margin="0,0,10,0"
                    Content="Verify an existing .fwz…" Click="BtnVerify_Click"/>
            <Button x:Name="BtnSelfTest" Padding="12,8"
                    Content="Self-test (MD5-crypt)" Click="BtnSelfTest_Click"/>
        </StackPanel>

        <!-- Row 3: result label -->
        <TextBlock Grid.Row="3" Text="Result:" Margin="0,0,0,4" FontWeight="SemiBold"/>

        <!-- Row 4: result box -->
        <TextBox x:Name="TxtResult" Grid.Row="4"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="Choose a firmware, a public key and an output path, then click Build."/>

        <!-- Row 5: diagnostics -->
        <TextBlock Grid.Row="5" x:Name="TxtDiag" Margin="0,8,0,0"
                   Foreground="Gray" FontFamily="Consolas" FontSize="11"/>
    </Grid>
</Window>
