<Window x:Class="IntercomFirmwareTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntercomFirmwareTool.App"
        xmlns:loc="clr-namespace:IntercomFirmwareTool.App.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Win_Title}"
        Icon="Assets/Icons/AppIcon.ico"
        SizeToContent="Height" Width="760" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="Button" x:Key="BrowseButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Small flat icon button (Segoe MDL2 Assets glyphs) for the inline
             password actions: reveal, copy, generate. -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFBFBFBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Larger icon button for the form rows (Browse / choose / generate).
             Left-aligned so the first button of every row lines up vertically. -->
        <Style TargetType="Button" x:Key="RowIconButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="6,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Uniform data-entry field: same height everywhere, now with a soft rounded
             border, a hover cue and an accent focus ring — the single field style shared
             by the whole form (and the download card), so restyling it here lifts every
             input at once and keeps them coherent. Scrollbar visibility is template-bound
             so a multi-line consumer (the Result console) can still show them. -->
        <Style TargetType="TextBox" x:Key="InputField">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="#FF1F2933"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9FB3C8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0F6CBD"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFF3F5F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern check: a rounded box that fills accent-blue with a crisp tick when
             checked. Implicit (no key) so EVERY checkbox in the app adopts it and matches
             the download section — no per-control wiring. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF1F2933"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <!-- Transparent focus ring around the box: shown on keyboard focus so
                                 Tab users can see which checkbox Space will toggle, in both the
                                 checked and unchecked states (a plain border on the box wouldn't
                                 contrast against the accent-filled checked state). -->
                            <Border x:Name="focusRing" CornerRadius="7" BorderThickness="2"
                                    BorderBrush="Transparent" VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Margin="1"
                                        Background="White" BorderBrush="#FFB6C2D2" BorderThickness="1.5"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="check" Stretch="Uniform" Width="10" Height="10"
                                          Data="M 0,5 L 4,9 L 11,1" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF0F6CBD"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF0F6CBD"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF0F6CBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRing" Property="BorderBrush" Value="#FF0F6CBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Download official firmware (issue #23) ============ -->
        <!-- Link-style disclosure that opens the download card. Sits under the
             firmware box and is revealed only after the startup availability probe
             finds at least one online, size-matching official file. Chevron flips
             down (collapsed) ↔ up (expanded). -->
        <Style TargetType="ToggleButton" x:Key="DownloadLink">
            <Setter Property="Foreground" Value="#FF0F6CBD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="5,3" SnapsToDevicePixels="True"
                                BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <!-- Download glyph -->
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:Loc Dl_Toggle}" VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                                <!-- ChevronDown (collapsed) / ChevronUp (expanded) -->
                                <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" VerticalAlignment="Center" Margin="7,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#170F6CBD"/>
                            </Trigger>
                            <!-- Keyboard-focus cue: a visible accent outline (the transparent
                                 1px border is always present, so showing it never shifts layout). -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#170F6CBD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0F6CBD"/>
                            </Trigger>
                            <!-- Unavailable state (Tag="unavailable", set in code when the startup
                                 probe can't offer any firmware — offline OR reachable-but-empty):
                                 render muted and non-interactive-looking — grey text, no chevron, no
                                 hover highlight, arrow cursor. The control stays ENABLED so a click
                                 can still warn (TglDownload_Changed) instead of opening the card.
                                 Placed last so its Transparent background wins over the hover/focus
                                 highlight. -->
                            <Trigger Property="Tag" Value="unavailable">
                                <Setter Property="Foreground" Value="#FF9AA0A6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                                <Setter TargetName="chev" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented "pill" selector (model / version). A RadioButton so a group
             is single-select and screen-reader-correct; the bullet is replaced by a
             rounded chip that fills accent-blue when chosen. -->
        <Style TargetType="RadioButton" x:Key="SegmentPill">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Background" Value="#FFEEF3F9"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="15" Background="{TemplateBinding Background}"
                                    BorderBrush="#FFDCE6F1" BorderThickness="1" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Keyboard-focus halo: a high-contrast ring drawn just OUTSIDE the pill
                                 so it reads on both the light (unchecked) and blue (checked) states,
                                 telling keyboard users which group the arrow keys will move. Overlay
                                 (not a border on bd) so showing it never shifts the pill's layout. -->
                            <Border x:Name="focus" CornerRadius="17" BorderBrush="#FF00335A"
                                    BorderThickness="2" Margin="-3" SnapsToDevicePixels="True"
                                    IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE1EAF4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0F6CBD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0F6CBD"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim, rounded, accent-filled progress bar for the download. -->
        <Style TargetType="ProgressBar" x:Key="SlimBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#FF0F6CBD"/>
            <Setter Property="Background" Value="#FFE3EAF2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern flat action buttons (Windows 11 / Fluent look): a filled accent
             PRIMARY for the main call-to-action and a subtle bordered SECONDARY for
             the rest. Flat fills (no 3-D gradient), 6px rounded corners, smooth
             hover/press states, a visible keyboard-focus ring and a clear disabled
             state. Shared 36px height so the row lines up. -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF0F6CBD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1A79C9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0B5C9E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF00335A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFDCDCDC"/>
                                <Setter Property="Foreground" Value="#FF9A9A9A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <!-- "Loading" look: while a build runs the button is DISABLED
                                 (so it can't be re-invoked, incl. via UI Automation) but
                                 Tag="busy" keeps it full-colour and readable. This wins
                                 over the disabled greying above. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False"/>
                                    <Condition Property="Tag" Value="busy"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#FF0F6CBD"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Foreground" Value="#FF1F1F1F"/>
            <Setter Property="Background" Value="#FFFDFDFD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="#FFD2D2D2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F3F3"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFC4C4C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE9E9E9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0F6CBD"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFF7F7F7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFE8E8E8"/>
                                <Setter Property="Foreground" Value="#FFAFAFAF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Advanced options" disclosure toggle: a subtle, link-like ToggleButton
             with a chevron that rotates from ▸ (collapsed) to ▾ (expanded). Keeps the
             default view simple while advanced tools stay one click away. -->
        <Style TargetType="ToggleButton" x:Key="DisclosureToggle">
            <Setter Property="Foreground" Value="#FF3A3A3A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="6,4" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <!-- ChevronRight (collapsed) / ChevronDown (expanded),
                                     swapped by the IsChecked trigger below. -->
                                <TextBlock x:Name="chev" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Loc Adv_Toggle}" VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                            <!-- Hover fill only; it clears when the mouse leaves.
                                 Keyboard focus is shown by the default OS focus visual
                                 (only when tabbing), so no persistent fill lingers after
                                 a mouse click. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#11000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded, brand-coloured button for the "buy me a coffee" links.
             Background/Foreground are set per-button to each brand's colour. -->
        <Style TargetType="Button" x:Key="DonateButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <!-- Symmetric horizontal margin: in the UniformGrid this keeps an even
                 gap between the buttons AND equal padding on the block's outer edges. -->
            <Setter Property="Margin" Value="4,0,4,0"/>
            <!-- Equal height (fixed) restored to the original taller size; equal
                 WIDTH comes from the UniformGrid host, which sizes both cells to the
                 wider button — so neither is forced wider than its natural size. -->
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Constant 2px transparent border so the keyboard-focus ring
                             (below) appears without shifting the layout. ClipToBounds
                             keeps the shine sweep inside the button. -->
                        <Border x:Name="pill" Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Shine: a soft, skewed light band parked off the left
                                     edge; the code-behind sweeps sheenT across at random
                                     intervals (independently per button) for a subtle glint. -->
                                <Border x:Name="sheen" Width="46" HorizontalAlignment="Left"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#4DFFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-18"/>
                                            <TranslateTransform x:Name="sheenT" X="-90"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#CCFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pill" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating "new options below" pill: a transient, accent, drop-shadowed
             toast anchored at the bottom of the scroll area. It appears momentarily when
             content grows past the fold and scrolls the user to it on click. -->
        <!-- Deliberately a DARK slate surface (not accent blue): a floating toast must
             stand apart from the blue action buttons it may overlap and read as elevated
             above the form. White label + a light-blue chevron for a subtle brand pop. -->
        <Style TargetType="Button" x:Key="ScrollCueButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF0A1220" BlurRadius="16" ShadowDepth="3"
                                                  Opacity="0.42" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#FF334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#FF0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brand icons, transcoded from Assets/Icons/PayPal.svg and Revolut.svg
             into native WPF vectors (WPF can't render .svg directly; this keeps
             the app dependency-free). The .svg files remain the design source. -->
        <DrawingImage x:Key="PayPalIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#002991" Geometry="F1 M38.914 13.35c0 5.574-5.144 12.15-12.927 12.15H18.49l-.368 2.322L16.373 39H7.056l5.605-36h15.095c5.083 0 9.082 2.833 10.555 6.77a9.687 9.687 0 0 1 .603 3.58z"/>
                    <GeometryDrawing Brush="#60CDFF" Geometry="F1 M44.284 23.7A12.894 12.894 0 0 1 31.53 34.5h-5.206L24.157 48H14.89l1.483-9 1.75-11.178.367-2.322h7.497c7.773 0 12.927-6.576 12.927-12.15 3.825 1.974 6.055 5.963 5.37 10.35z"/>
                    <GeometryDrawing Brush="#008CFF" Geometry="F1 M38.914 13.35C37.31 12.511 35.365 12 33.248 12h-12.64L18.49 25.5h7.497c7.773 0 12.927-6.576 12.927-12.15z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="RevolutIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#000000" Geometry="F1 M209.051 262.097h101.445v410.21H209.051z"/>
                    <GeometryDrawing Brush="#000000" Geometry="F1 M628.623 285.554c0-87.043-70.882-157.86-158.011-157.86H209.051v87.603h249.125c39.43 0 72.093 30.978 72.814 69.051 0.361 19.064-6.794 37.056-20.146 50.66-13.357 13.61-31.204 21.109-50.251 21.109h-97.046c-3.446 0-6.25 2.8-6.25 6.245v77.859c0 1.324 0.409 2.59 1.179 3.656l164.655 228.43h120.53L478.623 443.253C561.736 439.08 628.623 369.248 628.623 285.554z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <!-- Asymmetric inset: a smaller TOP margin so the top-right toolbar (gear + globe)
         sits close to the title bar instead of floating with dead space above it; the
         sides and bottom keep the roomier 14px breathing space. -->
    <Grid Margin="14,6,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- scrollable body -->
            <RowDefinition Height="Auto"/>   <!-- pinned footer (diagnostics + support) -->
        </Grid.RowDefinitions>

        <!-- Scrollable body: everything above the footer. The optional MQTT panel can
             make the form taller than the window, so a ScrollViewer keeps the lower
             fields reachable instead of clipped, while the footer below stays pinned. -->
        <Grid Grid.Row="0">
        <!-- No horizontal padding: the body content (banners included) then keeps the SAME left
             and right inset as the pinned footer below — both bounded only by the window's outer
             margin — so every banner lines up symmetrically. A reserved right gutter here would push
             the body 10px in on the right only, making the banners asymmetric with the footer. When
             the vertical scrollbar does appear (Advanced expanded), it insets the content on its own,
             as usual. -->
        <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0"
                      ScrollChanged="BodyScroll_ScrollChanged">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: language menu + intro/safety -->
            <RowDefinition Height="Auto"/>   <!-- 1: input form -->
            <RowDefinition Height="Auto"/>   <!-- 2: Build (centered) + hint -->
            <RowDefinition Height="Auto"/>   <!-- 3: advanced options disclosure -->
            <RowDefinition Height="Auto"/>   <!-- 4: result output (part of Advanced) -->
        </Grid.RowDefinitions>

        <!-- Row 0: a discreet top-right toolbar (settings gear + globe language menu),
             the update banners (issue #85), then the safety note -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <!-- Settings gear: startup update-check opt-out, manual check, About -->
                <Menu x:Name="SettingsMenu" Background="Transparent" Padding="0"
                      VerticalAlignment="Center"
                      ToolTip="{loc:Loc Settings_MenuTooltip}"
                      AutomationProperties.Name="{loc:Loc Settings_MenuTooltip}">
                    <!-- Glyph in a header TextBlock, NOT FontFamily on the MenuItem: FontFamily is
                         inheritable, so setting the icon font on the parent item would render the
                         submenu labels ("Check for updates…", "About") in the icon font too. -->
                    <!-- Match the language item's height (it's naturally a touch taller because it
                         carries a text label) instead of a magic Height that would leave dead space
                         above/below the lone gear glyph. MinHeight (not Height) bound to its
                         ActualHeight: during the first measure ActualHeight is still 0, so binding
                         Height would briefly collapse the gear — as a MinHeight, a 0 just lets the
                         item size to its own glyph, then it grows to match once layout settles.
                         Symmetric Padding + centered content keep the box models coherent;
                         FontSize 14 matches the language globe glyph. -->
                    <MenuItem MinHeight="{Binding ActualHeight, ElementName=LangMenuRoot}" Padding="8,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="{loc:Loc Settings_MenuTooltip}"
                              AutomationProperties.Name="{loc:Loc Settings_MenuTooltip}">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </MenuItem.Header>
                        <MenuItem x:Name="MnuCheckUpdatesStartup" IsCheckable="True"
                                  Header="{loc:Loc Settings_CheckOnStartup}"
                                  Click="MnuCheckUpdatesStartup_Click"/>
                        <MenuItem x:Name="MnuCheckNow" Header="{loc:Loc Settings_CheckNow}"
                                  Click="MnuCheckNow_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MnuAbout" Header="{loc:Loc Settings_About}"
                                  Click="MnuAbout_Click"/>
                    </MenuItem>
                </Menu>
                <Menu x:Name="LangMenu" Background="Transparent" Padding="0"
                      VerticalAlignment="Center"
                      ToolTip="{loc:Loc Lang_MenuTooltip}"
                      AutomationProperties.Name="{loc:Loc Lang_MenuTooltip}">
                    <!-- The height REFERENCE: this item sizes to its natural content (globe glyph +
                         language label); the settings item above binds its MinHeight to this one's
                         ActualHeight. Same symmetric Padding + centered content so both top-level
                         items and their hover highlight match. -->
                    <MenuItem x:Name="LangMenuRoot" Padding="8,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Menu>
            </StackPanel>

            <!-- Mandatory "unsafe version" banner (red, non-dismissible): replaces the safety
                 warning below and disables the actions. Shown only when the running build is
                 below the maintainer-flagged minimum-supported version. -->
            <Border x:Name="UpdateBlockBanner" Visibility="Collapsed"
                    Background="#FFFDECEA" BorderBrush="#FFE9A79F"
                    BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                            Background="#FFF7D2CC" VerticalAlignment="Top" Margin="0,0,11,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#FFB42318" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="BtnUpdateBlockDownload" DockPanel.Dock="Right"
                            VerticalAlignment="Center" Margin="10,0,0,0" Padding="12,5"
                            Content="{loc:Loc Update_Download}" Click="BtnUpdateDownload_Click"/>
                    <!-- LiveSetting sits on the TextBlock (the element AnnounceLiveRegion raises the
                         event on), so screen readers announce the mandatory message. -->
                    <TextBlock x:Name="TxtUpdateBlockBanner" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="#FF7A160E"
                               AutomationProperties.LiveSetting="Assertive"/>
                </DockPanel>
            </Border>

            <!-- Informational "update available" banner (blue, dismissible): coexists ABOVE the
                 safety warning; all controls stay enabled. -->
            <Border x:Name="UpdateBanner" Visibility="Collapsed"
                    Background="#FFEAF3FE" BorderBrush="#FFAFD3F2"
                    BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                            Background="#FFD2E6FB" VerticalAlignment="Top" Margin="0,0,11,0">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#FF1B6FC4" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="BtnUpdateDownload" Padding="12,5"
                                Content="{loc:Loc Update_Download}" Click="BtnUpdateDownload_Click"/>
                        <Button x:Name="BtnUpdateDismiss" Margin="8,0,0,0" Padding="12,5"
                                Content="{loc:Loc Update_Dismiss}" Click="BtnUpdateDismiss_Click"/>
                    </StackPanel>
                    <!-- LiveSetting sits on the TextBlock (the element AnnounceLiveRegion raises the
                         event on), so screen readers announce the update message. -->
                    <TextBlock x:Name="TxtUpdateBanner" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="#FF12456E"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>

            <Border x:Name="RiskBanner" Background="#FFFFF8EC" BorderBrush="#FFF0DBA8"
                    BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <!-- Warning glyph in a soft amber badge -->
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                            Background="#FFFBEAC2" VerticalAlignment="Top" Margin="0,0,11,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#FFB8860B" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF7A5B00"><Run Text="{loc:Loc Banner_Risk_Pre}"/><Run Text="{loc:Loc Banner_Risk_Emph}" FontWeight="Bold" TextDecorations="Underline"/><Run Text="{loc:Loc Banner_Use_Pre}"/><Hyperlink NavigateUri="https://assets.legrand.com/pim/AUTRE/MyHOME_Suite_030538.exe" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="{loc:Loc Banner_Link}"/></Hyperlink><Run Text="{loc:Loc Banner_Use_Post}"/></TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Row 1: the input form, grouped in a soft card so the primary flow reads as
             one designed surface, coherent with the download card. -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,14" CornerRadius="10"
                Background="#FFFCFDFE" BorderBrush="#FFE7EDF3" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: firmware -->
                <RowDefinition Height="Auto"/>   <!-- 1: password -->
                <RowDefinition Height="Auto"/>   <!-- 2: confirm -->
                <RowDefinition Height="Auto"/>   <!-- 3: credential rule -->
                <RowDefinition Height="Auto"/>   <!-- 4: output -->
            </Grid.RowDefinitions>

            <!-- Firmware .fwz — the box, the "download official firmware" link, and
                 the (collapsed) download card share column 1 so the card can grow the
                 Auto row and push the fields below it down. The label and clear button
                 pin to the TOP so they stay next to the box, not the grown cell. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Top" Margin="0,4,12,0"
                       Text="{loc:Loc Field_Firmware}"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                <TextBox x:Name="TxtFwzPath"
                         Style="{StaticResource InputField}" IsReadOnly="True"
                         Cursor="Hand" ToolTip="{loc:Loc Tip_Firmware}"
                         PreviewMouseLeftButtonDown="TxtFwzPath_MouseDown" PreviewKeyDown="TxtFwzPath_PreviewKeyDown"
                         Foreground="Gray"/>

                <!-- Download official firmware (issue #23). Invisible until the startup availability
                     probe finishes, then revealed in place: enabled if a source is online, or muted
                     and non-opening (Tag="unavailable", a click warns) if nothing usable was found —
                     whether offline or a server answered with nothing to offer.
                     Visibility=Hidden (not Collapsed) RESERVES its layout slot from the first frame,
                     so the auto-sized window opens at its final height and the async reveal fills the
                     reserved space without a visible resize. -->
                <ToggleButton x:Name="TglDownload" Style="{StaticResource DownloadLink}"
                              Visibility="Hidden" Margin="0,6,0,0"
                              Checked="TglDownload_Changed" Unchecked="TglDownload_Changed"
                              AutomationProperties.Name="{loc:Loc Dl_Toggle}"
                              ToolTip="{loc:Loc Dl_ToggleTip}"/>

                <Border x:Name="DownloadCard" Visibility="Collapsed" Margin="0,8,0,4"
                        Padding="16,14" CornerRadius="10"
                        Background="#FFF6FAFE" BorderBrush="#FFD8E4F1" BorderThickness="1">
                    <StackPanel>
                        <!-- Header: accent badge + title / subtitle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="#FF0F6CBD" Margin="0,0,11,0">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Dl_Title}" FontWeight="SemiBold"
                                           FontSize="13.5" Foreground="#FF16202B"/>
                                <TextBlock Text="{loc:Loc Dl_Subtitle}" FontSize="11.5"
                                           Foreground="#FF6B7C8D" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Reassurance / legal note -->
                        <Border Background="#FFEDF4FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock Text="{loc:Loc Dl_Legal}" FontSize="11.5"
                                       Foreground="#FF4A5B6B" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Model -->
                        <TextBlock Text="{loc:Loc Dl_Model}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#FF334155" Margin="0,0,0,7"/>
                        <WrapPanel x:Name="ModelPills"/>

                        <!-- Version — the extra top margin is headroom for the "Latest" badge,
                             which overhangs the newest pill's top-right corner. -->
                        <TextBlock Text="{loc:Loc Dl_Version}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#FF334155" Margin="0,6,0,7"/>
                        <WrapPanel x:Name="VersionPills" Margin="0,6,0,0"/>

                        <!-- Destination folder (click box or Browse…) -->
                        <TextBlock Text="{loc:Loc Dl_SaveTo}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#FF334155" Margin="0,6,0,7"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDlFolder" Grid.Column="0" Style="{StaticResource InputField}"
                                     Height="30" IsReadOnly="True" Cursor="Hand" Foreground="#FF334155"
                                     ToolTip="{loc:Loc Dl_SaveToTip}"
                                     AutomationProperties.Name="{loc:Loc Dl_SaveTo}"
                                     PreviewMouseLeftButtonDown="DlFolder_MouseDown"
                                     PreviewKeyDown="DlFolder_PreviewKeyDown"/>
                            <Button x:Name="BtnDlBrowse" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Height="30" Margin="8,0,0,0" Padding="14,0"
                                    Content="{loc:Loc Dl_Browse}" Click="BtnDlBrowse_Click"/>
                        </Grid>

                        <!-- Primary action + the result (success / error / cancelled)
                             shown INLINE to the right of the button — a cache hit has no
                             progress bar, so the message reads best right beside it. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnDlStart" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Height="34" HorizontalAlignment="Left" MinWidth="190" IsEnabled="False"
                                    Content="{loc:Loc Dl_Start}" Click="BtnDlStart_Click"/>
                            <TextBlock x:Name="TxtDlStatus" Grid.Column="1" Visibility="Collapsed"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>

                        <!-- Progress (shown only while a download runs) -->
                        <StackPanel x:Name="DlProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="DlProgress" Grid.Column="0" Style="{StaticResource SlimBar}"
                                             VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                                <Button x:Name="BtnDlCancel" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Height="28" Margin="12,0,0,0" Padding="12,0"
                                        Content="{loc:Loc Dl_Cancel}" Click="BtnDlCancel_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtDlProgress" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="#FF64748B" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Row="0" Grid.Column="2" x:Name="BtnClearFwz" VerticalAlignment="Top"
                    Style="{StaticResource RowIconButton}" Content="&#xE711;" IsEnabled="False"
                    ToolTip="{loc:Loc Tip_ClearFirmware}"
                    AutomationProperties.Name="{loc:Loc Tip_ClearFirmware}"
                    Click="BtnClearFwz_Click"/>

            <!-- Root password (masked) + reveal toggle + Disable (key-only). One of
                 the password or the key is required; ticking Disable turns password
                 login off, so a key becomes the credential. -->
            <!-- Text is set in code (UpdateAdvancedVisibility): "Password:" in the
                 simple view, "Root Password:" in Advanced — and re-localized on a
                 language switch. No {loc:Loc} binding here, so the imperative value is
                 the single source of truth (a binding + imperative set would fight). -->
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblPassword"
                       Style="{StaticResource FieldLabel}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <Grid Width="170">
                    <TextBox x:Name="TxtPassword" Style="{StaticResource InputField}"
                             FontFamily="Consolas"/>
                    <!-- Placeholder overlay: shown (by UpdateRequiredCues) only while
                         the password is blank in password mode. -->
                    <TextBlock x:Name="PhPassword" Text="{loc:Loc Ph_Required}" Foreground="Gray"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
                <!-- Inline actions, in order: generate, reveal (hold-to-show eye),
                     copy. Reveal affects BOTH the password and confirm fields. -->
                <Button x:Name="BtnRandomPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8B1;" ToolTip="{loc:Loc Tip_GenPassword}"
                        AutomationProperties.Name="{loc:Loc Tip_GenPassword}"
                        Click="BtnRandomPwd_Click"/>
                <Button x:Name="BtnToggleReveal" Style="{StaticResource IconButton}"
                        Content="&#xE7B3;" ToolTip="{loc:Loc Tip_RevealHold}"
                        AutomationProperties.Name="{loc:Loc Tip_RevealHold}"/>
                <Button x:Name="BtnCopyPwd" Style="{StaticResource IconButton}"
                        Content="&#xE8C8;" ToolTip="{loc:Loc Tip_CopyPassword}"
                        AutomationProperties.Name="{loc:Loc Tip_CopyPassword}"
                        Click="BtnCopyPwd_Click"/>
                <CheckBox x:Name="ChkKeyOnly" VerticalAlignment="Center" Margin="16,0,0,0"
                          Content="{loc:Loc Chk_Disable}"
                          ToolTip="{loc:Loc Tip_Disable}"
                          Checked="ChkKeyOnly_Toggled" Unchecked="ChkKeyOnly_Toggled"/>
            </StackPanel>

            <!-- Confirm password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="{loc:Loc Field_ConfirmPassword}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <Grid Width="170">
                    <TextBox x:Name="TxtConfirm" Style="{StaticResource InputField}"
                             FontFamily="Consolas"/>
                    <!-- Placeholder overlay: shown only after a password is typed and
                         while confirm is still blank (UpdateRequiredCues). -->
                    <TextBlock x:Name="PhConfirm" Text="{loc:Loc Ph_Required}" Foreground="Gray"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="8,0,0,0" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="TxtPwdHint" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray"/>
            </StackPanel>

            <!-- The credential rule. Matches the actual Build gate: a root password is
                 required in the default (password-login) mode; ticking "Disable" turns
                 password login off and makes the SSH key (in Advanced) the required
                 credential instead. -->
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                       x:Name="LblCredentialRule"
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                       <!-- Text set in code (UpdateAdvancedVisibility): simple / advanced /
                            key-only wording, re-localized on a language switch. -->

            <!-- Output (disabled until a firmware is chosen) -->
            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblOutput" IsEnabled="False"
                       Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_SaveOutput}"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtOutputPath"
                     Style="{StaticResource InputField}" IsReadOnly="True" IsEnabled="False"
                     Cursor="Hand" ToolTip="{loc:Loc Tip_Output}"
                     PreviewMouseLeftButtonDown="TxtOutputPath_MouseDown" PreviewKeyDown="TxtOutputPath_PreviewKeyDown"
                     Foreground="Gray"/>
            <Button Grid.Row="4" Grid.Column="2" x:Name="BtnClearOutput"
                    Style="{StaticResource RowIconButton}" IsEnabled="False"
                    Content="&#xE711;" ToolTip="{loc:Loc Tip_ClearOutput}"
                    AutomationProperties.Name="{loc:Loc Tip_ClearOutput}"
                    Click="BtnClearOutput_Click"/>
        </Grid>
        </Border>

        <!-- Row 2: the primary action (centered), then an always-visible one-line
             status area for short simple-view messages (firmware verifying, password
             copied, key errors) — the full log lives in Advanced → Result. -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <!-- Three columns ([*][Build][*]) keep the button dead-centre regardless
                 of the hint length; the hint sits in the right column, beside it. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- MinWidth keeps the button a stable size when its label is swapped
                     for the busy "Building…" state, so it doesn't shrink. -->
                <Button Grid.Column="1" x:Name="BtnBuild" Style="{StaticResource PrimaryButton}"
                        MinWidth="210" IsEnabled="False"
                        Content="{loc:Loc Btn_Build}" Click="BtnBuild_Click"/>
                <!-- Live "what's still needed to Build" hint; updated by UpdateBuildEnabled.
                     LiveSetting=Polite so a screen reader announces the changing
                     "still needed" / "Ready to build" text as the form is filled. -->
                <TextBlock Grid.Column="2" x:Name="TxtBuildHint" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Margin="14,0,0,0" Foreground="Gray"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <!-- Transient status line (collapsed when empty). -->
            <TextBlock x:Name="TxtStatus" Visibility="Collapsed" HorizontalAlignment="Center"
                       Margin="0,7,0,0" Foreground="Gray" FontSize="11"
                       TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- Row 3: Advanced options. A subtle divider + disclosure toggle keeps the
             default view simple; expanding reveals the SSH key row and the tool
             buttons below the toggle. -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Border Height="1" Background="#FFE7E7E7" Margin="0,0,0,8"/>
            <ToggleButton x:Name="TglAdvanced" Style="{StaticResource DisclosureToggle}"
                          Checked="TglAdvanced_Changed" Unchecked="TglAdvanced_Changed"
                          AutomationProperties.Name="{loc:Loc Adv_Toggle}"
                          ToolTip="{loc:Loc Tip_Advanced}"/>

            <!-- SSH public key (advanced). Also shown in key-only mode, or once a key
                 is selected, so a required/active credential is never hidden. -->
            <Grid x:Name="KeyRow" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="LblKey" Style="{StaticResource FieldLabel}"
                           Text="{loc:Loc Field_SshKey}"/>
                <TextBox Grid.Column="1" x:Name="TxtKeyPath"
                         Style="{StaticResource InputField}" IsReadOnly="True"
                         Cursor="Hand" ToolTip="{loc:Loc Tip_Key}"
                         PreviewMouseLeftButtonDown="TxtKeyPath_MouseDown" PreviewKeyDown="TxtKeyPath_PreviewKeyDown"
                         Foreground="Gray"/>
                <StackPanel Grid.Column="2" x:Name="KeyButtons" Orientation="Horizontal">
                    <Button x:Name="BtnGenKey" Style="{StaticResource RowIconButton}"
                            ToolTip="{loc:Loc Tip_GenKey}"
                            AutomationProperties.Name="{loc:Loc Aria_GenKey}"
                            Click="BtnGenKey_Click">
                        <!-- Key glyph with a small green "＋" badge = generate a NEW key.
                             The Segoe key points its shaft/teeth to the lower-right, so
                             the badge sits in the empty TOP-RIGHT corner to avoid covering
                             the key. The key inherits the button Foreground (greys when
                             disabled); the plus is drawn as two rounded bars to stay crisp. -->
                        <Grid Width="20" Height="18" SnapsToDevicePixels="True">
                            <TextBlock Text="&#xE192;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#FF107C10" CornerRadius="6" Width="12" Height="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-2,-3,0">
                                <Grid>
                                    <Rectangle Fill="White" Width="6" Height="2" RadiusX="1" RadiusY="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Rectangle Fill="White" Width="2" Height="6" RadiusX="1" RadiusY="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnClearKey" Style="{StaticResource RowIconButton}"
                            Content="&#xE711;" IsEnabled="False"
                            ToolTip="{loc:Loc Tip_ClearKey}"
                            AutomationProperties.Name="{loc:Loc Aria_ClearKey}"
                            Click="BtnClearKey_Click"/>
                </StackPanel>
            </Grid>

            <!-- Block firmware auto-updates (advanced, optional). Maps the Legrand
                 OTA blob hosts to 127.0.0.1 so an over-the-air update can't silently
                 reflash the unit and wipe the mod. Off by default (matches fquinto);
                 shown while Advanced is open, or kept visible while ticked so an
                 active build option isn't hidden behind the toggle. -->
            <StackPanel x:Name="BlockUpdatesSection" Margin="0,12,0,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkBlockUpdates" Content="{loc:Loc Chk_BlockUpdates}"
                          ToolTip="{loc:Loc Tip_BlockUpdates}"
                          Checked="ChkBlockUpdates_Toggled" Unchecked="ChkBlockUpdates_Toggled"/>
                <TextBlock Margin="22,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="{loc:Loc Hint_BlockUpdates}"/>
            </StackPanel>

            <!-- Modern SSH host key (advanced, optional, issue #37). The factory
                 dropbear only has an RSA host key, so it offers only the SHA-1
                 ssh-rsa host-key algorithm that OpenSSH >= 8.8 rejects by default.
                 Ticking this bakes an ECDSA host key into the image (the device's
                 dropbear supports ecdsa-sha2-nistp256) and points dropbear at it, so
                 a modern `ssh` connects without -o HostKeyAlgorithms=+ssh-rsa. Off by
                 default; same visibility/lock rule as the OTA-block row. -->
            <StackPanel x:Name="ModernHostKeySection" Margin="0,12,0,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkModernHostKey" Content="{loc:Loc Chk_ModernHostKey}"
                          ToolTip="{loc:Loc Tip_ModernHostKey}"
                          Checked="ChkModernHostKey_Toggled" Unchecked="ChkModernHostKey_Toggled"/>
                <TextBlock Margin="22,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="{loc:Loc Hint_ModernHostKey}"/>
            </StackPanel>

            <!-- Keep .sig signature sidecars (advanced, optional). Off by default =
                 remove them, exactly like fquinto (remove_sig='y'). Kept for parity/
                 research; the sidecar for the modified payload is stale, so a
                 signature-checking updater could reject a kept archive. -->
            <StackPanel x:Name="KeepSigSection" Margin="0,12,0,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkKeepSig" Content="{loc:Loc Chk_KeepSig}"
                          ToolTip="{loc:Loc Tip_KeepSig}"
                          Checked="ChkKeepSig_Toggled" Unchecked="ChkKeepSig_Toggled"/>
                <TextBlock Margin="22,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="{loc:Loc Hint_KeepSig}"/>
            </StackPanel>

            <!-- MQTT bridge (advanced, optional). Off by default: ticking the box
                 reveals the config panel. The section is shown while Advanced is open,
                 or kept visible while enabled so an active build option is never
                 hidden behind the toggle (mirrors the SSH key row). -->
            <StackPanel x:Name="MqttSection" Margin="0,12,0,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkMqtt" Content="{loc:Loc Chk_Mqtt}"
                          ToolTip="{loc:Loc Tip_Mqtt}"
                          Checked="ChkMqtt_Toggled" Unchecked="ChkMqtt_Toggled"/>
                <StackPanel x:Name="MqttPanel" Margin="22,8,0,0" Visibility="Collapsed">
                    <!-- Network-discovery note (#43): shown while scanning and when a broker
                         found on the LAN pre-fills the fields below. Live region so a screen
                         reader announces the auto-fill. -->
                    <TextBlock x:Name="TxtMqttDiscovery" Margin="0,0,0,6" Foreground="#FF3C7D3C"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 0: broker host + port + test -->
                            <RowDefinition Height="Auto"/>   <!-- 1: host IP (hostname only) -->
                            <RowDefinition Height="Auto"/>   <!-- 2: username -->
                            <RowDefinition Height="Auto"/>   <!-- 3: password -->
                            <RowDefinition Height="Auto"/>   <!-- 4: TLS CA cert -->
                            <RowDefinition Height="Auto"/>   <!-- 5: TLS client cert -->
                            <RowDefinition Height="Auto"/>   <!-- 6: TLS client key -->
                            <RowDefinition Height="Auto"/>   <!-- 7: allow remote shell -->
                            <RowDefinition Height="Auto"/>   <!-- 8: remote shell warning -->
                        </Grid.RowDefinitions>

                        <!-- Broker host + port + Test connection -->
                        <TextBlock x:Name="LblMqttBroker" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttBroker}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="TxtMqttHost" Style="{StaticResource InputField}" Width="200"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblMqttBroker}"
                                     ToolTip="{loc:Loc Tip_MqttBroker}" TextChanged="MqttBrokerField_TextChanged"/>
                            <TextBlock x:Name="LblMqttPort" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"
                                       Text="{loc:Loc Field_MqttPort}"/>
                            <TextBox x:Name="TxtMqttPort" Style="{StaticResource InputField}" Width="70"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblMqttPort}"
                                     ToolTip="{loc:Loc Tip_MqttPort}" TextChanged="MqttField_TextChanged"/>
                            <Button x:Name="BtnMqttTest" Style="{StaticResource SecondaryButton}"
                                    Height="28" Margin="12,0,0,0" Padding="12,0"
                                    Content="{loc:Loc Btn_MqttTest}" ToolTip="{loc:Loc Tip_MqttTest}"
                                    Click="BtnMqttTest_Click"/>
                        </StackPanel>

                        <!-- Host IP mapping — shown only when the broker is a hostname.
                             The device resolves broker names via bt_hosts.sh, so a name
                             needs an IPv4 for the bt_daemon-apps.sh edit. Blank = resolve
                             it automatically at build time. -->
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblMqttHostIp"
                                   Style="{StaticResource FieldLabel}" Visibility="Collapsed"
                                   Text="{loc:Loc Field_MqttHostIp}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtMqttHostIp"
                                 Style="{StaticResource InputField}" Margin="0,0,0,6"
                                 HorizontalAlignment="Left" Width="200" Visibility="Collapsed"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttHostIp}"
                                 ToolTip="{loc:Loc Tip_MqttHostIp}" TextChanged="MqttBrokerField_TextChanged"/>

                        <!-- Username (optional; set with a password) -->
                        <TextBlock x:Name="LblMqttUser" Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttUser}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtMqttUser"
                                 Style="{StaticResource InputField}" Margin="0,0,0,6"
                                 HorizontalAlignment="Left" Width="200"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttUser}"
                                 ToolTip="{loc:Loc Tip_MqttUser}" TextChanged="MqttField_TextChanged"
                                 LostFocus="MqttUser_LostFocus"/>

                        <!-- Password (masked) + reveal -->
                        <TextBlock x:Name="LblMqttPass" Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttPass}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="TxtMqttPass" Style="{StaticResource InputField}"
                                     Width="200" FontFamily="Consolas"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblMqttPass}"/>
                            <Button x:Name="BtnMqttReveal" Style="{StaticResource IconButton}"
                                    Content="&#xE7B3;" ToolTip="{loc:Loc Tip_MqttReveal}"
                                    AutomationProperties.Name="{loc:Loc Tip_MqttReveal}"
                                    Click="BtnMqttReveal_Click"/>
                        </StackPanel>

                        <!-- TLS CA certificate (optional; enables one-way TLS) -->
                        <TextBlock x:Name="LblMqttCa" Grid.Row="4" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttCa}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtMqttCaPath"
                                 Style="{StaticResource InputField}" IsReadOnly="True" Cursor="Hand"
                                 Margin="0,0,0,6" Foreground="Gray" ToolTip="{loc:Loc Tip_MqttCa}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttCa}"
                                 PreviewMouseLeftButtonDown="MqttPem_MouseDown" PreviewKeyDown="MqttPem_PreviewKeyDown"/>
                        <Button Grid.Row="4" Grid.Column="2" x:Name="BtnClearMqttCa"
                                Style="{StaticResource RowIconButton}" Content="&#xE711;" IsEnabled="False"
                                ToolTip="{loc:Loc Tip_MqttClearFile}"
                                Click="MqttPemClear_Click"/>

                        <!-- TLS client certificate (optional; with the key = mutual TLS) -->
                        <TextBlock x:Name="LblMqttClientCert" Grid.Row="5" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttClientCert}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtMqttCertPath"
                                 Style="{StaticResource InputField}" IsReadOnly="True" Cursor="Hand"
                                 Margin="0,0,0,6" Foreground="Gray" ToolTip="{loc:Loc Tip_MqttClientCert}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttClientCert}"
                                 PreviewMouseLeftButtonDown="MqttPem_MouseDown" PreviewKeyDown="MqttPem_PreviewKeyDown"/>
                        <Button Grid.Row="5" Grid.Column="2" x:Name="BtnClearMqttCert"
                                Style="{StaticResource RowIconButton}" Content="&#xE711;" IsEnabled="False"
                                ToolTip="{loc:Loc Tip_MqttClearFile}"
                                Click="MqttPemClear_Click"/>

                        <!-- TLS client private key (optional; with the cert = mutual TLS) -->
                        <TextBlock x:Name="LblMqttClientKey" Grid.Row="6" Grid.Column="0"
                                   Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttClientKey}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtMqttKeyPath"
                                 Style="{StaticResource InputField}" IsReadOnly="True" Cursor="Hand"
                                 Margin="0,0,0,6" Foreground="Gray" ToolTip="{loc:Loc Tip_MqttClientKey}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttClientKey}"
                                 PreviewMouseLeftButtonDown="MqttPem_MouseDown" PreviewKeyDown="MqttPem_PreviewKeyDown"/>
                        <Button Grid.Row="6" Grid.Column="2" x:Name="BtnClearMqttKey"
                                Style="{StaticResource RowIconButton}" Content="&#xE711;" IsEnabled="False"
                                ToolTip="{loc:Loc Tip_MqttClearFile}"
                                Click="MqttPemClear_Click"/>

                        <!-- Gated remote command channel — disabled until client auth is
                             configured; toggling it on asks for confirmation (code-behind). -->
                        <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ChkMqttRemoteShell"
                                  Margin="0,4,0,0" IsEnabled="False" Content="{loc:Loc Chk_MqttRemoteShell}"
                                  ToolTip="{loc:Loc Tip_MqttRemoteShell}"
                                  Checked="MqttOption_Changed" Unchecked="MqttOption_Changed"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                   Margin="0,3,0,0" Foreground="#FF9A6A00" FontSize="11" TextWrapping="Wrap"
                                   Text="{loc:Loc Warn_MqttRemoteShell}"/>
                    </Grid>

                    <!-- Test-connection result (transient) -->
                    <TextBlock x:Name="TxtMqttTestStatus" Margin="0,4,0,0" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>

                    <!-- Structured JSON bus payloads (Phase 2, #12 item 3). ON by default
                         (set in InitMqttUi): publishes one structured object per frame on
                         TOPIC_DUMP; with HA discovery on, the bus entity exposes the parsed
                         fields as attributes. Untick for raw OpenWebNet frames. -->
                    <CheckBox x:Name="ChkMqttJsonPayload" Margin="0,10,0,0"
                              Content="{loc:Loc Chk_MqttJson}" ToolTip="{loc:Loc Tip_MqttJson}"
                              Checked="MqttOption_Changed" Unchecked="MqttOption_Changed"/>
                    <TextBlock Margin="22,3,0,0" Foreground="#FF666666" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Hint_MqttJson}"/>

                    <!-- Broker rediscovery (#43/#44). ON by default (IsChecked set in
                         InitMqttUi, NOT here — same InitializeComponent ordering reason as
                         the other toggles). When the broker's LAN IP changes, the device
                         scans its /24 and repoints the broker name's /etc/hosts mapping. It
                         self-gates on the device (needs a hostname config + a TLS anchor),
                         so on-by-default is safe. -->
                    <CheckBox x:Name="ChkMqttRediscovery" Margin="0,10,0,0"
                              Content="{loc:Loc Chk_MqttRediscovery}" ToolTip="{loc:Loc Tip_MqttRediscovery}"
                              Checked="MqttOption_Changed" Unchecked="MqttOption_Changed"/>
                    <TextBlock Margin="22,3,0,0" Foreground="#FF666666" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Hint_MqttRediscovery}"/>
                    <!-- Gold-standard primary fix (issue #43, Layer A): a DHCP reservation +
                         hostname makes the broker IP stable, so rediscovery above is only a
                         safety net. Documented in Payload/mqtt/README.md too. -->
                    <TextBlock Margin="22,3,0,0" Foreground="#FF666666" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Hint_MqttDhcpReservation}"/>
                    <!-- Captured-anchor note (transient): set by the Test-connection MAC
                         capture, hidden otherwise. Live region so a screen reader announces
                         a fresh capture / suggestion. -->
                    <TextBlock x:Name="TxtMqttRediscoveryInfo" Margin="22,3,0,0" Foreground="#FF3C7D3C"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>

                    <!-- Home Assistant auto-discovery (Phase 2, #12 item 1). ON by
                         default when the bridge is installed (plug-and-play): publishes
                         retained, read-only discovery configs so the bridge's entities
                         appear in Home Assistant with no manual YAML. Read-only, so the
                         secure-by-default posture holds; untick to skip (a later build
                         then clears any previously-published entities). -->
                    <!-- IsChecked (default on) is set in InitMqttUi, NOT here, so the
                         Checked handler can't fire during InitializeComponent before the
                         masked password fields it reads are constructed. -->
                    <CheckBox x:Name="ChkMqttHaDiscovery" Margin="0,10,0,0"
                              Content="{loc:Loc Chk_MqttHaDiscovery}" ToolTip="{loc:Loc Tip_MqttHaDiscovery}"
                              Checked="MqttOption_Changed" Unchecked="MqttOption_Changed"/>
                    <TextBlock Margin="22,3,0,0" Foreground="#FF666666" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Hint_MqttHaDiscovery}"/>
                    <!-- Per-unit HA device id: distinct values give each bridge its own
                         HA device/entities (a multi-unit broker also needs distinct MQTT
                         topics, else the devices mirror each other's data — see HaNodeId
                         doc). Deliberately ALWAYS editable — not tied
                         to the checkbox — because the opt-out/clear path also needs it:
                         with discovery unchecked, btmqttd clears the retained
                         configs for THIS node id, so the user must be able to enter the
                         id a previous build published under (a disabled field, reset to
                         the default in a new session, would clear the wrong identity).
                         The default Text is set in InitMqttUi (see the checkbox note). -->
                    <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                        <TextBlock x:Name="LblMqttHaNodeId" Text="{loc:Loc Field_MqttHaNodeId}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtMqttHaNodeId" Width="200" Style="{StaticResource InputField}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttHaNodeId}"
                                 ToolTip="{loc:Loc Tip_MqttHaNodeId}"
                                 TextChanged="MqttField_TextChanged"/>
                    </StackPanel>

                    <!-- Exterior light (opt-in). "Has exterior light" reveals the WHERE field; a
                         BLANK WHERE means LEARN it at runtime (the "Learn light" button in HA
                         captures it from the next physical press). The WHO=8 actuator WHERE (digits)
                         is captured as *8*21*<WHERE>## on the bus — installation-specific. -->
                    <CheckBox x:Name="ChkMqttHasLight" Margin="22,8,0,0"
                              Content="{loc:Loc Chk_MqttHasLight}" ToolTip="{loc:Loc Tip_MqttHasLight}"
                              Checked="ChkMqttHasLight_Toggled" Unchecked="ChkMqttHasLight_Toggled"/>
                    <!-- Light type: how the physical installation behaves. Bistable (default) keeps
                         the tracked on/off switch + resync; Momentary is for a staircase-timer that
                         auto-offs, shown in HA as a single press button (no state). -->
                    <StackPanel x:Name="LightTypePanel" Margin="40,6,0,0" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Lbl_MqttLightType}" FontWeight="SemiBold"
                                   Margin="0,0,0,2"/>
                        <RadioButton x:Name="RbMqttLightBistable" GroupName="MqttLightType"
                                     IsChecked="True" Content="{loc:Loc Rb_MqttLightBistable}"
                                     ToolTip="{loc:Loc Tip_MqttLightBistable}"/>
                        <TextBlock Text="{loc:Loc Txt_MqttLightBistable}" Foreground="Gray"
                                   FontSize="11" TextWrapping="Wrap" Margin="18,0,0,4"/>
                        <RadioButton x:Name="RbMqttLightMomentary" GroupName="MqttLightType"
                                     Content="{loc:Loc Rb_MqttLightMomentary}"
                                     ToolTip="{loc:Loc Tip_MqttLightMomentary}"/>
                        <TextBlock Text="{loc:Loc Txt_MqttLightMomentary}" Foreground="Gray"
                                   FontSize="11" TextWrapping="Wrap" Margin="18,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="LightWherePanel" Orientation="Horizontal" Margin="40,4,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="LblMqttLightWhere" Text="{loc:Loc Field_MqttLightWhere}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtMqttLightWhere" Width="200" Style="{StaticResource InputField}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblMqttLightWhere}"
                                 ToolTip="{loc:Loc Tip_MqttLightWhere}"
                                 TextChanged="MqttField_TextChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="LblMqttLightLearnHint" Margin="40,3,0,0" Foreground="Gray"
                               FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="{loc:Loc Hint_MqttLightLearn}"/>

                    <!-- Secondary lock (opt-in): create the Secondary Lock HA entity only when the
                         installation actually wires a second gate. Off by default. -->
                    <CheckBox x:Name="ChkMqttSecondaryLock" Margin="22,8,0,0"
                              Content="{loc:Loc Chk_MqttSecondaryLock}"
                              ToolTip="{loc:Loc Tip_MqttSecondaryLock}"/>

                    <!-- Topics (collapsible, prefilled with the Home Assistant defaults) -->
                    <CheckBox x:Name="ChkMqttTopics" Margin="0,10,0,0"
                              Content="{loc:Loc Chk_MqttTopics}" ToolTip="{loc:Loc Tip_MqttTopics}"
                              Checked="ChkMqttTopics_Toggled" Unchecked="ChkMqttTopics_Toggled"/>
                    <Grid x:Name="MqttTopicsPanel" Margin="22,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblMqttTopicRx" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicRx}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMqttTopicRx" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicRx}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicDump" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicDump}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMqttTopicDump" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicDump}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicStartDate" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicStartDate}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMqttTopicStartDate" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicStartDate}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicLastWill" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicLastWill}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtMqttTopicLastWill" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicLastWill}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicKey" Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicKey}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtMqttTopicKey" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicKey}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicCmdResult" Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicCmdResult}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtMqttTopicCmdResult" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicCmdResult}" TextChanged="MqttField_TextChanged"/>
                        <TextBlock x:Name="LblMqttTopicFileContent" Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{loc:Loc Field_MqttTopicFileContent}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtMqttTopicFileContent" Style="{StaticResource InputField}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="260" AutomationProperties.LabeledBy="{Binding ElementName=LblMqttTopicFileContent}" TextChanged="MqttField_TextChanged"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AdvancedTools" Orientation="Horizontal" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="BtnVerify" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Content="{loc:Loc Btn_Inspect}" Click="BtnVerify_Click"/>
                <Button x:Name="BtnSelfTest" Style="{StaticResource SecondaryButton}"
                        Content="{loc:Loc Btn_SelfTest}" Click="BtnSelfTest_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Row 4: result output — part of Advanced options. Hidden by default and
             shown only while Advanced is expanded (driven by TglAdvanced). Inspect /
             Self-test are launched from an open Advanced, so their output is visible
             here; Build reports its outcome in a popup and its full log lands here for
             whenever Advanced is opened. -->
        <DockPanel x:Name="ResultGroup" Grid.Row="4" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Lbl_Result}" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <!-- Bounded height with its own scrollbar: inside the page ScrollViewer a
                 star-fill box can't work (the viewer offers infinite height), so a long
                 build log scrolls within this box while the page scrolls around it. The
                 rounded border lives on the wrapper so the console matches the form
                 fields (the TextBox itself is borderless). -->
            <Border CornerRadius="6" Background="#FFFBFCFD" BorderBrush="#FFDDE4EC"
                    BorderThickness="1" Padding="2">
                <TextBox x:Name="TxtResult" MaxHeight="320"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Text="{loc:Loc Result_Default}"/>
            </Border>
        </DockPanel>
        </Grid>
        </ScrollViewer>

        <!-- Transient "new options below" cue, overlaid at the bottom of the scroll
             area (hidden until content grows past the fold; see MainWindow.ScrollCue.cs).
             RenderTransform is named so the code can slide/bounce it in. -->
        <Button x:Name="ScrollCue" Style="{StaticResource ScrollCueButton}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,12" Visibility="Collapsed" Opacity="0"
                RenderTransformOrigin="0.5,0.5" Click="ScrollCue_Click"
                AutomationProperties.LiveSetting="Assertive">
            <Button.RenderTransform>
                <TranslateTransform x:Name="ScrollCueTranslate" Y="14"/>
            </Button.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Scroll_More}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="#FF6BB6F0" VerticalAlignment="Center" Margin="9,1,0,0"/>
            </StackPanel>
        </Button>
        </Grid>

        <!-- Pinned footer: diagnostics + support. Outside the ScrollViewer so it stays
             visible however tall the scrollable body grows. -->
        <StackPanel Grid.Row="1">
        <!-- diagnostics -->
        <TextBlock x:Name="TxtDiag" Margin="0,8,0,0"
                   Foreground="Gray" FontFamily="Consolas" FontSize="11"/>

        <!-- support / buy me a coffee -->
        <Border Margin="0,10,0,0" Padding="12,9"
                Background="#FFFBF7EF" BorderBrush="#FFE6D6AE" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DockPanel (not a horizontal StackPanel) so the message TextBlock is
                     measured with a constrained width and actually wraps instead of
                     overflowing and pushing the buttons off-screen at small widths. -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#x2615;" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF5B4A1E"><Run Text="{loc:Loc Donate_Pre}"/><Run Text="{loc:Loc Donate_Emph}" FontWeight="SemiBold"/><Run Text="{loc:Loc Donate_Post}"/></TextBlock>
                </DockPanel>

                <!-- UniformGrid: both cells take the width of the WIDER button, so
                     PayPal and Revolut end up equal without forcing an arbitrary width. -->
                <UniformGrid Grid.Column="1" Rows="1" Columns="2" VerticalAlignment="Center">
                    <!-- PayPal -->
                    <Button x:Name="BtnPayPal" Style="{StaticResource DonateButton}"
                            Background="#FF003087" Click="BtnPayPal_Click"
                            ToolTip="{loc:Loc Tip_PayPal}"
                            AutomationProperties.Name="{loc:Loc Aria_PayPal}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Brand icon on a white chip (the multi-blue PayPal mark
                                 would be unreadable directly on the blue button). -->
                            <Border x:Name="IcoPayPal" Width="24" Height="24" CornerRadius="5"
                                    Background="White" Padding="3" Margin="0,0,7,0">
                                <Image Source="{StaticResource PayPalIcon}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="PayPal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Revolut -->
                    <Button x:Name="BtnRevolut" Style="{StaticResource DonateButton}"
                            Background="#FF191C1F" Click="BtnRevolut_Click"
                            ToolTip="{loc:Loc Tip_Revolut}"
                            AutomationProperties.Name="{loc:Loc Aria_Revolut}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Brand icon on a white chip (the dark Revolut mark would
                                 be unreadable directly on the near-black button). -->
                            <Border x:Name="IcoRevolut" Width="24" Height="24" CornerRadius="5"
                                    Background="White" Padding="4" Margin="0,0,7,0">
                                <Image Source="{StaticResource RevolutIcon}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Revolut" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</Window>
