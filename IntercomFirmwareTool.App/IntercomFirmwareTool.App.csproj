<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\Icons\AppIcon.ico</ApplicationIcon>

    <!-- Product metadata → the shipped .exe's file properties. The release workflow (#79)
         overrides Version from the git tag (-p:Version=X.Y.Z, which also drives FileVersion
         and InformationalVersion). The 0.0.0 default marks a local/dev build — which the
         planned in-app update check (#85) treats as "don't nag". -->
    <Version>0.0.0</Version>
    <Product>Intercom Firmware Tool</Product>
    <AssemblyTitle>Intercom Firmware Tool</AssemblyTitle>
    <Authors>jorgeavlobo</Authors>
    <Company>jorgeavlobo</Company>
    <Description>Firmware customization tool for BTicino / Legrand Classe 100X / 300X intercoms.</Description>
    <!-- Complete file version-info metadata. Blank/sparse metadata nudges antivirus
         heuristic/ML scoring toward "suspicious"; a full set (Product/Company/Description/
         Copyright + an icon) is one of the cheap, sign-free ways to lower that score. -->
    <Copyright>Copyright © 2026 jorgeavlobo</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so Window.Icon="Assets/Icons/AppIcon.ico" resolves via a pack
         URI at runtime (the title-bar/taskbar icon). ApplicationIcon above is a
         separate mechanism that embeds the icon into the .exe itself. -->
    <Resource Include="Assets\Icons\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntercomFirmwareTool.Core\IntercomFirmwareTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only third-party runtime dependency: MQTTnet powers the Advanced-tab
         "Test connection" button (a real MQTT CONNECT that also exercises the
         configured auth + TLS). On the 5.x line: the client types moved into the
         root MQTTnet namespace (MQTTnet.Client is gone), the factory is now
         MqttClientFactory, and the CONNECT default flipped to MQTT 5.0 (a
         documented breaking change) — the test code pins 3.1.1 explicitly to keep
         mirroring the device's mosquitto client. Pinned to an exact patch version for reproducible
         restores, matching the repo's convention (e.g. SharpZipLib); bump
         deliberately when needed. -->
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
