<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SharpExt4.dll é mixed-mode C++/CLI e Ijwhost.dll é nativa x64:
         todo o processo tem de correr como x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SharpExt4">
      <HintPath>lib\SharpExt4\SharpExt4.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- TargetPath achata o caminho: as DLLs vão para a RAIZ do output (ao
         lado do .exe), não para bin\...\lib\SharpExt4\. A Ijwhost.dll nativa
         só é encontrada pelo loader se estiver ao lado do executável. -->
    <None Update="lib\SharpExt4\DiskPartitionInfo.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>DiskPartitionInfo.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Ijwhost.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\SharpExt4.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
