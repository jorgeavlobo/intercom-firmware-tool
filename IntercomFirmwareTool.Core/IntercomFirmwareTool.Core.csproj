<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SharpExt4.dll is mixed-mode C++/CLI and Ijwhost.dll is native x64:
         the whole process must run as x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project reads back GenerateConf's output (the byte-exact device .conf) to
         assert the camera-target serialization (#111). Expose internals to it only. -->
    <InternalsVisibleTo Include="IntercomFirmwareTool.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SharpExt4">
      <HintPath>lib\SharpExt4\SharpExt4.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ZipCrypto (the traditional ZIP password) is not supported by
         System.IO.Compression; SharpZipLib supports it. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Optional "download official firmware" flow (issue #23): a fast, resumable,
         multipart downloader (MIT, no external deps) for fetching a registry entry, and
         Polly v8 (BSD-3-Clause) for the industry-standard resilience pipeline (exponential
         backoff + jitter, honoring Retry-After) on the startup availability probes. Both
         permissive, no copyleft. Pinned to exact versions for reproducible restores, matching
         the repo convention; bump deliberately. The downloaded bytes are always re-verified
         against the registry's size + SHA-256 before use — the libraries are transport only. -->
    <PackageReference Include="Downloader" Version="5.9.5" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge: the prebuilt ARM binary (btmqttd, a statically-linked Rust
         daemon built from this repo's native/btmqttd source — first-party, not
         third-party) the installer writes into the firmware image, plus its
         aggregated dependency-license notice and the THIRD_PARTY provenance,
         embedded so the assembly is self-contained. Retrieved as byte[] / string via
         PayloadBinaries (SHA-256 verified). These files are included as default
         `None` items too, so Remove them first to avoid a duplicate-item (NETSDK1022)
         error. LogicalName is set explicitly so the manifest resource name is stable
         regardless of MSBuild's path-to-name munging. See Payload/vendor/THIRD_PARTY.md
         for provenance/licensing. -->
    <None Remove="Payload\vendor\armhf\btmqttd" />
    <None Remove="Payload\vendor\THIRD_PARTY.md" />
    <None Remove="Payload\vendor\licenses\btmqttd-THIRD-PARTY-LICENSES.txt" />
    <EmbeddedResource Include="Payload\vendor\armhf\btmqttd">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.armhf.btmqttd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\THIRD_PARTY.md">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.THIRD_PARTY.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\btmqttd-THIRD-PARTY-LICENSES.txt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.btmqttd-THIRD-PARTY-LICENSES.txt</LogicalName>
    </EmbeddedResource>
    <!-- Minimal LGPL static-musl armv7 ffmpeg for the on-device media server (#120,
         Phase 1a) — a THIRD-PARTY binary (FFmpeg n7.1.1), built per native/ffmpeg/BUILD.md,
         with its LGPL-2.1 text. Same Remove-then-EmbeddedResource + explicit LogicalName
         pattern as btmqttd. Verified on read (length + SHA-256) by PayloadBinaries. -->
    <None Remove="Payload\vendor\armhf\ffmpeg" />
    <None Remove="Payload\vendor\licenses\ffmpeg-COPYING.LGPLv2.1.txt" />
    <EmbeddedResource Include="Payload\vendor\armhf\ffmpeg">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.armhf.ffmpeg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\ffmpeg-COPYING.LGPLv2.1.txt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.ffmpeg-COPYING.LGPLv2.1.txt</LogicalName>
    </EmbeddedResource>
    <!-- musl's MIT license: BOTH the ffmpeg and btmqttd binaries statically link musl libc
         objects (via zig cc / the Rust musl target), whose MIT notice is required (musl's
         exception only waives headers/CRT). Sourced from the pinned zig distribution and
         shared by both binaries. Same Remove-then-EmbeddedResource + explicit LogicalName. -->
    <None Remove="Payload\vendor\licenses\musl-COPYRIGHT.txt" />
    <EmbeddedResource Include="Payload\vendor\licenses\musl-COPYRIGHT.txt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.musl-COPYRIGHT.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge: the only payload script the installer writes into the firmware
         image is the SysV watchdog init script that launches + respawns the native
         btmqttd daemon. The shell-orchestrated bridge (StartMqttSend/StartMqttReceive,
         keypress.sh, filter.py, ha_discovery.sh, mqtt_common.sh, TcpDump2Mqtt[.sh]) is
         fully replaced by btmqttd and no longer shipped. LF-pinned via .gitattributes;
         MqttInstaller also normalizes to LF defensively. Same Remove-then-
         EmbeddedResource + explicit LogicalName pattern as the vendor binary above. -->
    <None Remove="Payload\mqtt\btmqttd" />
    <EmbeddedResource Include="Payload\mqtt\btmqttd">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.btmqttd</LogicalName>
    </EmbeddedResource>
    <None Remove="Payload\mqtt\bt_service_watchdog" />
    <EmbeddedResource Include="Payload\mqtt\bt_service_watchdog">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.bt_service_watchdog</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- TargetPath flattens the path: the DLL goes to the output ROOT (next to the .exe),
         not to bin\...\lib\SharpExt4\. Ijwhost.dll is the native C++/CLI host that the loader
         must find beside the executable, and it is NOT listed in SharpExt4.deps.json, so this
         manual copy is its ONLY source — keep it.
         (DiskPartitionInfo.dll is deliberately NOT copied here: SharpExt4.deps.json declares it
         as a runtime dependency, so the SDK already resolves it to the output root. A second
         manual copy of it made `dotnet publish` fail with NETSDK1152 / a duplicate single-file
         bundle entry — the loose copy vs the auto-resolved one. `dotnet build` tolerated the
         duplicate, which is why only the release workflow surfaced it. #79 follow-up.) -->
    <None Update="lib\SharpExt4\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Ijwhost.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\SharpExt4.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <!-- SharpExt4.dll (mixed-mode C++/CLI) imports VCRUNTIME140.dll, which is NOT part of a
         clean Windows install and is NOT supplied by dotnet self-contained publish. The release
         workflow (#79) drops the Microsoft-redistributable vcruntime140.dll here just before
         publishing so it ships app-local (flattened to the output root, next to SharpExt4, and
         bundled into the single-file for first-run extraction). This is an `Update` on an
         optional file: it's a no-op for local/CI builds where the DLL is absent (those hosts
         already have the VC++ runtime), and only takes effect in the release build. -->
    <None Update="lib\SharpExt4\vcruntime140.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>vcruntime140.dll</TargetPath>
    </None>
  </ItemGroup>

</Project>
