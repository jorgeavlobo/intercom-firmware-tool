<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SharpExt4.dll is mixed-mode C++/CLI and Ijwhost.dll is native x64:
         the whole process must run as x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SharpExt4">
      <HintPath>lib\SharpExt4\SharpExt4.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ZipCrypto (the traditional ZIP password) is not supported by
         System.IO.Compression; SharpZipLib supports it. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge (Phase 1b): the verbatim third-party ARM binaries the
         installer writes into the firmware image, plus their license notices,
         embedded so the assembly is self-contained. Retrieved as byte[] /
         string via PayloadBinaries (SHA-256 verified). These files are
         included as default `None` items too, so Remove them first to avoid a
         duplicate-item (NETSDK1022) error. LogicalName is set explicitly so
         the manifest resource name is stable regardless of MSBuild's path-to-
         name munging. See Payload/vendor/THIRD_PARTY.md for provenance/licensing. -->
    <None Remove="Payload\vendor\armhf\jq" />
    <None Remove="Payload\vendor\armhf\evtest" />
    <None Remove="Payload\vendor\THIRD_PARTY.md" />
    <None Remove="Payload\vendor\licenses\jq-COPYING" />
    <None Remove="Payload\vendor\licenses\evtest-COPYING" />
    <None Remove="Payload\vendor\licenses\oniguruma-COPYING" />
    <None Remove="Payload\vendor\licenses\glibc-LGPL-2.1.txt" />
    <EmbeddedResource Include="Payload\vendor\armhf\jq">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.armhf.jq</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\armhf\evtest">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.armhf.evtest</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\THIRD_PARTY.md">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.THIRD_PARTY.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\jq-COPYING">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.jq-COPYING</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\evtest-COPYING">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.evtest-COPYING</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\oniguruma-COPYING">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.oniguruma-COPYING</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\glibc-LGPL-2.1.txt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.glibc-LGPL-2.1.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge (Phase 1c): the payload scripts MqttInstaller writes into the
         firmware image, embedded (LF-pinned via .gitattributes; MqttInstaller also
         normalizes to LF defensively). TcpDump2Mqtt.conf is NOT embedded — it is
         generated from MqttOptions; README.md is docs, not payload. Same
         Remove-then-EmbeddedResource + explicit LogicalName pattern as the
         vendor binaries above. -->
    <None Remove="Payload\mqtt\TcpDump2Mqtt" />
    <None Remove="Payload\mqtt\TcpDump2Mqtt.sh" />
    <None Remove="Payload\mqtt\StartMqttSend" />
    <None Remove="Payload\mqtt\StartMqttReceive" />
    <None Remove="Payload\mqtt\keypress.sh" />
    <None Remove="Payload\mqtt\filter.py" />
    <None Remove="Payload\mqtt\mqtt_common.sh" />
    <None Remove="Payload\mqtt\ha_discovery.sh" />
    <None Remove="Payload\mqtt\presence.sh" />
    <None Remove="Payload\mqtt\bt_service_watchdog" />
    <EmbeddedResource Include="Payload\mqtt\TcpDump2Mqtt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.TcpDump2Mqtt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\TcpDump2Mqtt.sh">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.TcpDump2Mqtt.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\StartMqttSend">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.StartMqttSend</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\StartMqttReceive">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.StartMqttReceive</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\keypress.sh">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.keypress.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\filter.py">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.filter.py</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\mqtt_common.sh">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.mqtt_common.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\ha_discovery.sh">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.ha_discovery.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\presence.sh">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.presence.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\mqtt\bt_service_watchdog">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.bt_service_watchdog</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- TargetPath flattens the path: the DLLs go to the output ROOT (next to
         the .exe), not to bin\...\lib\SharpExt4\. The native Ijwhost.dll is
         only found by the loader if it sits next to the executable. -->
    <None Update="lib\SharpExt4\DiskPartitionInfo.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>DiskPartitionInfo.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Ijwhost.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\SharpExt4.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
