<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SharpExt4.dll is mixed-mode C++/CLI and Ijwhost.dll is native x64:
         the whole process must run as x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SharpExt4">
      <HintPath>lib\SharpExt4\SharpExt4.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ZipCrypto (the traditional ZIP password) is not supported by
         System.IO.Compression; SharpZipLib supports it. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge: the verbatim third-party ARM binary (btmqttd, a statically-
         linked Rust daemon) the installer writes into the firmware image, plus its
         aggregated dependency-license notice and the THIRD_PARTY provenance,
         embedded so the assembly is self-contained. Retrieved as byte[] / string via
         PayloadBinaries (SHA-256 verified). These files are included as default
         `None` items too, so Remove them first to avoid a duplicate-item (NETSDK1022)
         error. LogicalName is set explicitly so the manifest resource name is stable
         regardless of MSBuild's path-to-name munging. See Payload/vendor/THIRD_PARTY.md
         for provenance/licensing. -->
    <None Remove="Payload\vendor\armhf\btmqttd" />
    <None Remove="Payload\vendor\THIRD_PARTY.md" />
    <None Remove="Payload\vendor\licenses\btmqttd-THIRD-PARTY-LICENSES.txt" />
    <EmbeddedResource Include="Payload\vendor\armhf\btmqttd">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.armhf.btmqttd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\THIRD_PARTY.md">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.THIRD_PARTY.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Payload\vendor\licenses\btmqttd-THIRD-PARTY-LICENSES.txt">
      <LogicalName>IntercomFirmwareTool.Core.Payload.vendor.licenses.btmqttd-THIRD-PARTY-LICENSES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- MQTT bridge: the only payload script the installer writes into the firmware
         image is the SysV watchdog init script that launches + respawns the native
         btmqttd daemon. The shell-orchestrated bridge (StartMqttSend/StartMqttReceive,
         keypress.sh, filter.py, ha_discovery.sh, mqtt_common.sh, TcpDump2Mqtt[.sh]) is
         fully replaced by btmqttd and no longer shipped. LF-pinned via .gitattributes;
         MqttInstaller also normalizes to LF defensively. Same Remove-then-
         EmbeddedResource + explicit LogicalName pattern as the vendor binary above. -->
    <None Remove="Payload\mqtt\bt_service_watchdog" />
    <EmbeddedResource Include="Payload\mqtt\bt_service_watchdog">
      <LogicalName>IntercomFirmwareTool.Core.Payload.mqtt.bt_service_watchdog</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- TargetPath flattens the path: the DLLs go to the output ROOT (next to
         the .exe), not to bin\...\lib\SharpExt4\. The native Ijwhost.dll is
         only found by the loader if it sits next to the executable. -->
    <None Update="lib\SharpExt4\DiskPartitionInfo.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>DiskPartitionInfo.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Ijwhost.dll</TargetPath>
    </None>
    <None Update="lib\SharpExt4\SharpExt4.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
