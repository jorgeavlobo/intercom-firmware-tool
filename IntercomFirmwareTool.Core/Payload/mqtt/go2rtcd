#!/bin/sh
### BEGIN INIT INFO
# Provides:          go2rtcd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: go2rtc - on-device camera media server
# Description:       Starts/stops the on-device go2rtc media server (issue #120).
#                    It reads the panel's cleartext RTP (fanned to 127.0.0.2 by
#                    btmqttd) via a generated SDP, runs the vendored ffmpeg to copy
#                    the H.264 into RTSP, and serves it to Home Assistant as a native
#                    Generic Camera. Reads /etc/btmqttd/go2rtc/go2rtc.yaml. Also opens
#                    the RTSP media port (:8554) in the panel firewall, LAN-source-
#                    restricted (phase 1c-3). The desired state is a marker file
#                    (DISABLED); bt_service_watchdog reconciles the running process AND
#                    re-asserts the firewall rule each pass via `respawn`.
### END INIT INFO
#
# MIT-licensed, part of IntercomFirmwareTool. A byte-for-byte copy of the btmqttd
# init script's supervision model (atomic mkdir mutex LOCKDIR + DISABLED marker),
# retargeted at the go2rtc binary. Only an explicit `start` clears the marker; the
# supervisor's `respawn` never does, so a `stop` for maintenance is honoured until
# the operator starts it again (or a reboot clears the tmpfs marker).
PATH=/sbin:/usr/sbin:/usr/bin:/bin
DAEMON=/usr/sbin/go2rtc
NAME=go2rtc
CONFIG=/etc/btmqttd/go2rtc/go2rtc.yaml
LOGDIR=/var/log/go2rtc
LOGFILE=$LOGDIR/go2rtc.log
LOCKDIR=/var/run/go2rtc.lock
DISABLED=/var/run/go2rtc.disabled

# Firewall (issue #120, phase 1c-3): the RTSP media port + the LAN interface it is served on. The
# panel enforces a default-deny INPUT chain (`-P INPUT DROP`) and does NOT open :8554, so nothing
# reaches go2rtc from Home Assistant without a rule. The go2rtc control API (:1984) stays loopback-
# only and gets NO rule. Only this TCP port is opened, source-restricted to the LAN.
#
# We manage exactly ONE INPUT rule and nothing else: no sub-chain, no flush, no policy change. The rule
# carries an ownership TAG via the iptables comment match (`-m comment --comment go2rtcd`), so the tag —
# not the rest of the spec — is what makes the rule OURS. Cleanup deletes only rules bearing that comment,
# so a rule an admin/panel may have added that is byte-for-byte identical EXCEPT for the comment is never
# matched and never removed (CodeRabbit: a bare spec is a matcher, not an identity). This is the
# industry-standard approach (Docker/firewalld tag their rules the same way). The tag is REQUIRED: if the
# kernel lacks the comment match (xt_comment) we FAIL CLOSED — add no rule, leave :8554 shut — rather than
# insert an untagged rule we couldn't distinguish from a foreign one and might delete on cleanup. That is
# the safe, gold-standard choice; xt_comment is present on essentially all Linux kernels, so failing
# closed only ever bites a stripped kernel, and never at the cost of touching someone else's rule. (A
# second CAP_NET_ADMIN manager could still rewrite the firewall wholesale, but that actor already fully
# controls netfilter — no userspace script can defend against it; the same boundary Docker/kube-proxy
# accept.)
CAM_PORT=8554
CAM_IFACE=wlan0
FW_TAG=go2rtcd
# Remembers the exact source subnet of the (tagged) rule we last inserted (tmpfs, cleared every boot with
# the ruleset), so a DHCP subnet change deletes the OLD rule precisely and close deletes what open added.
FW_STATE=/var/run/go2rtc.fwrule

# Drain EVERY rule carrying OUR comment tag for source subnet $1. Comment-scoped, so it can only ever
# match a rule WE added — an identical rule WITHOUT our comment (an admin's) is invisible here and is
# never touched, no matter where it sits in INPUT.
fw_del() {
	while iptables -D INPUT -i "$CAM_IFACE" -p tcp --dport "$CAM_PORT" -s "$1" \
		-m comment --comment "$FW_TAG" -j ACCEPT 2>/dev/null; do :; done
}

# 0 (true) ONLY when a SUCCESSFUL `iptables -S INPUT` listing shows NO rule carrying our tag — i.e. we
# can positively confirm our rule is absent. If the listing itself fails (a transient backend error) OR a
# tagged rule is still present, return non-zero so callers KEEP FW_STATE and retry later. An inspection
# error must never be mistaken for "confirmed gone", and a failed `iptables -D` must not strand an open
# port with no state to retry against (Codex). The tag is a unique token, so grep for it is sufficient.
fw_gone() {
	out=$(iptables -S INPUT 2>/dev/null) || return 1
	printf '%s\n' "$out" | grep -q -- "$FW_TAG" && return 1
	return 0
}

# PIDs of the actual daemon. `pgrep -x go2rtc` matches the daemon binary; the init
# script's own shell process has comm "go2rtcd" (the script name), so it is not
# matched here. Keep btmqttd's readlink filter anyway — belt-and-suspenders against
# any other "go2rtc"-named process: only PIDs whose executable is $DAEMON count.
daemon_pids() {
	for p in $(/usr/bin/pgrep -x "$NAME" 2>/dev/null); do
		[ "$(readlink /proc/"$p"/exe 2>/dev/null)" = "$DAEMON" ] && echo "$p"
	done
}
is_running() { [ -n "$(daemon_pids)" ]; }

# Acquire the mutex (mkdir is atomic). Critical sections are short (never a
# kill+wait), so retry briefly; steal a stale lock after ~10s so a process killed
# mid-operation cannot wedge the service forever.
acquire() {
	i=0
	while ! mkdir "$LOCKDIR" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 10 ]; then rmdir "$LOCKDIR" 2>/dev/null; else sleep 1; fi
	done
}
release() { rmdir "$LOCKDIR" 2>/dev/null; }

# Signal every daemon instance. Defaults to SIGTERM; pass "-9" to force. (Without
# a default an argument-less call would run `kill "" <pid>` — an invalid signal
# operand that silently signals nothing.)
kill_all() {
	sig=${1:--TERM}
	for p in $(daemon_pids); do kill "$sig" "$p" 2>/dev/null; done
}

# Open the RTSP media port (issue #120, decision #4: least-privilege + LAN source-restrict). Idempotent
# and DHCP-proof. First delete the rule we previously applied (its subnet remembered in FW_STATE), so a
# subnet change leaves nothing of OURS stranded. Then, with an address, insert one TAGGED rule at the TOP
# so it sits above the policy DROP, source-restricted to CAM_IFACE's own subnet (derived at runtime;
# iptables masks the address to its /prefix). The subnet is written to FW_STATE BEFORE the insert, so any
# installed tagged rule is ALWAYS covered by cleanup state — a failure at/after the insert can never
# strand the port open with no cleanup target (CodeRabbit). Because each open first deletes the prior rule,
# a mid-pass failure leaves the rule DELETED (port closed), never stranded. If the state write itself
# fails we never insert (fail closed). Deletion is comment-scoped, so a recorded subnet with no rule
# (e.g. the insert fails on a kernel without xt_comment) is a harmless no-op at close and can never match
# a foreign rule. With NO address yet (the boot race before DHCP, or a lease drop) we insert NOTHING — the
# port stays closed, and the prior rule was already removed so nothing stale survives an address change
# (Codex). Re-running every watchdog pass re-adds the rule after the panel flushes INPUT. No `-C` needed
# (busybox iptables may lack it).
firewall_open() {
	command -v iptables >/dev/null 2>&1 || return 0
	lan=$(ip -4 addr show "$CAM_IFACE" 2>/dev/null | awk '/inet /{print $2; exit}')
	[ -s "$FW_STATE" ] && fw_del "$(cat "$FW_STATE")"
	if [ -z "$lan" ]; then
		# No address: insert nothing (the port must stay LAN-only). Clear state only if the prior rule is
		# CONFIRMED gone; a failed delete or a failed listing keeps it so a later pass can still remove the
		# old rule instead of orphaning it (Codex).
		fw_gone && rm -f "$FW_STATE" 2>/dev/null
		return 0
	fi
	# Belt-and-suspenders: drain any stale rule of ours for this subnet (safe — only our comment matches)
	# so re-asserting can never accumulate duplicates.
	fw_del "$lan"
	# Record intent-to-install BEFORE inserting; if we can't persist state we don't insert (fail closed).
	printf '%s' "$lan" > "$FW_STATE" 2>/dev/null || { rm -f "$FW_STATE" 2>/dev/null || true; return 0; }
	iptables -I INPUT -i "$CAM_IFACE" -p tcp --dport "$CAM_PORT" -s "$lan" \
		-m comment --comment "$FW_TAG" -j ACCEPT 2>/dev/null || true
}

# Close the media port again (service stopped/disabled/not running): delete the rule we last inserted
# (its subnet from FW_STATE). Comment-scoped, so it matches only rules with our tag — nothing we didn't
# add is touched. Forget the rule ONLY once fw_gone confirms it is absent via a successful listing: a
# transient `iptables -D` or `iptables -S` failure keeps FW_STATE so a later close/respawn retries the
# deletion instead of stranding an open port (Codex). If we never inserted one this boot (no state) there
# is nothing to do.
firewall_close() {
	command -v iptables >/dev/null 2>&1 || return 0
	[ -s "$FW_STATE" ] || return 0
	fw_del "$(cat "$FW_STATE")"
	fw_gone && rm -f "$FW_STATE" 2>/dev/null || true
}

# Launch the daemon iff enabled (no marker) and not already running. Caller holds
# the lock, so this cannot race a concurrent start/stop/respawn. Returns 0 ONLY when
# it actually backgrounded a new instance (disabled / already-running return 1), so
# the caller can `wait_running` for a just-launched child before deciding the firewall.
launch_if_enabled() {
	[ -e "$DISABLED" ] && return 1
	is_running && return 1
	if [ -L "$LOGDIR" ] || { [ -e "$LOGDIR" ] && [ ! -d "$LOGDIR" ]; }; then
		rm -f "$LOGDIR"
	fi
	mkdir -p "$LOGDIR" 2>/dev/null
	chmod 700 "$LOGDIR" 2>/dev/null
	[ -L "$LOGFILE" ] && rm -f "$LOGFILE"
	"$DAEMON" -config "$CONFIG" >> "$LOGFILE" 2>&1 &
	return 0
}

# Poll briefly for a just-backgrounded daemon to exec $DAEMON. Without this, the is_running check right
# after a launch can race the child's exec and read "down", so a manual start/restart would close the
# media port until the next watchdog pass ~60s later (Codex). Only ever called after launch_if_enabled
# reports it launched, so steady-state respawns (already running) never sleep. Bounded to ~5s — well
# under the ~10s lock-steal threshold — then returns is_running's verdict so a genuinely failed launch
# still ends with the port closed.
wait_running() {
	i=0
	while ! is_running && [ "$i" -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	is_running
}

case "$1" in
	start)
		# Operator/boot intent: enable the service, launch, then open the media port iff it came up.
		acquire
		rm -f "$DISABLED" 2>/dev/null
		launch_if_enabled && wait_running
		if is_running; then firewall_open; else firewall_close; fi
		release
		echo "$NAME started"
		;;
	respawn)
		# Supervisor-only reconcile (bt_service_watchdog). Under the lock: enforce
		# the desired state - if stopped (marker present) kill any lingering or
		# racily-started instance and close the port; otherwise (re)launch if it is
		# down and (re)assert the firewall rule — running firewall_open EVERY pass is
		# what re-opens :8554 after the panel rebuilds/flushes its chain. The rule is
		# tied to the daemon actually running, so a persistently failed launch (missing
		# binary/config) leaves no open port (Copilot). Never clears the marker, so it
		# cannot undo an operator's `stop`.
		acquire
		if [ -e "$DISABLED" ]; then
			kill_all
			firewall_close
		else
			launch_if_enabled && wait_running
			if is_running; then firewall_open; else firewall_close; fi
		fi
		release
		;;
	stop)
		# Operator intent: disable, then terminate. Set the marker FIRST (under the
		# lock) so no concurrent respawn relaunches, then kill every instance and
		# wait for graceful shutdown, escalating to SIGKILL. Killing outside the lock
		# keeps the lock hold short; the marker already suppresses respawn. Close the
		# media port once the daemon is down.
		acquire
		touch "$DISABLED" 2>/dev/null
		release
		printf '%s' "Stopping $NAME... "
		i=0
		while is_running && [ "$i" -lt 8 ]; do
			kill_all
			sleep 1
			i=$((i + 1))
		done
		is_running && kill_all -9
		firewall_close
		echo "done"
		;;
	status)
		if is_running; then
			echo "$NAME is running (PID $(daemon_pids | head -n 1))"
		elif [ -e "$DISABLED" ]; then
			echo "$NAME is stopped (disabled for maintenance)"
			exit 3
		else
			echo "$NAME is NOT running"
			exit 1
		fi
		;;
	restart)
		# `stop` sets the marker + waits for exit; `start` clears it + relaunches.
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|status|restart|respawn}"
		exit 1
		;;
esac

exit 0
