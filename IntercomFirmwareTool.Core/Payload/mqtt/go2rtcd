#!/bin/sh
### BEGIN INIT INFO
# Provides:          go2rtcd
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: go2rtc - on-device camera media server
# Description:       Starts/stops the on-device go2rtc media server (issue #120).
#                    It reads the panel's cleartext RTP (fanned to 127.0.0.2 by
#                    btmqttd) via a generated SDP, runs the vendored ffmpeg to copy
#                    the H.264 into RTSP, and serves it to Home Assistant as a native
#                    Generic Camera. Reads /etc/btmqttd/go2rtc/go2rtc.yaml. Also opens
#                    the RTSP media port (:8554) in the panel firewall, LAN-source-
#                    restricted (phase 1c-3). The desired state is a marker file
#                    (DISABLED); bt_service_watchdog reconciles the running process AND
#                    re-asserts the firewall rule each pass via `respawn`.
### END INIT INFO
#
# MIT-licensed, part of IntercomFirmwareTool. A byte-for-byte copy of the btmqttd
# init script's supervision model (atomic mkdir mutex LOCKDIR + DISABLED marker),
# retargeted at the go2rtc binary. Only an explicit `start` clears the marker; the
# supervisor's `respawn` never does, so a `stop` for maintenance is honoured until
# the operator starts it again (or a reboot clears the tmpfs marker).
PATH=/sbin:/usr/sbin:/usr/bin:/bin
DAEMON=/usr/sbin/go2rtc
NAME=go2rtc
CONFIG=/etc/btmqttd/go2rtc/go2rtc.yaml
LOGDIR=/var/log/go2rtc
LOGFILE=$LOGDIR/go2rtc.log
LOCKDIR=/var/run/go2rtc.lock
DISABLED=/var/run/go2rtc.disabled

# Runtime SDP assembly (issue #120). The rootfs (incl. /etc) is mounted READ-ONLY, so go2rtc cannot read
# a runtime-patched SDP under /etc. The installer writes a read-only TEMPLATE SDP; we (re)assemble the
# RUNTIME SDP on tmpfs at each (re)launch — copy the template, then splice in the learned
# sprop-parameter-sets that btmqttd (sprop.rs) persisted on the writable cfg/extra partition, if present.
# go2rtc.yaml's exec -i points at RUNTIME_SDP; btmqttd patches the same tmpfs path after a fresh learn.
TEMPLATE_SDP=/etc/btmqttd/go2rtc/doorbell.sdp
RUNTIME_SDP_DIR=/var/run/btmqttd
RUNTIME_SDP=$RUNTIME_SDP_DIR/doorbell.sdp
# The persisted learned sprop record (single line `<branch>\t<value>`). STATE_DIR mirrors persist.rs's
# DEFAULT_STATE_DIR and its $BTMQTTD_STATE_DIR override (tests/dev); on the device the env var is unset
# and the default is used.
STATE_DIR=${BTMQTTD_STATE_DIR:-/home/bticino/cfg/extra/btmqttd}
SPROP_FILE=$STATE_DIR/camera-sprop
# btmqttd's generated config, read ONLY to learn the CURRENT CAMERA_BRANCH. The sprop record is keyed
# by the branch it was learned on (task #41): hi/lo-res encode different SPS, and cfg/extra survives a
# reflash, so a record left by a previous install on the OTHER branch must not be spliced — btmqttd
# re-learns it. Absent/unreadable ⇒ default branch 1 (matches config.rs's CAMERA_BRANCH default).
CONF_FILE=/etc/btmqttd/btmqttd.conf

# Firewall (issue #120, phase 1c-3): the RTSP media port + the LAN interface it is served on. The
# panel enforces a default-deny INPUT chain (`-P INPUT DROP`) and does NOT open :8554, so nothing
# reaches go2rtc from Home Assistant without a rule. The go2rtc control API (:1984) stays loopback-
# only and gets NO rule. Only this TCP port is opened, source-restricted to the LAN.
#
# Ownership is a DEDICATED chain (FW_CHAIN), the industry-standard mechanism for a userspace program that
# manages iptables: Docker owns a `DOCKER` chain, kube-proxy owns `KUBE-*` chains, fail2ban owns `f2b-*`
# chains — all create/flush/populate/delete only THEIR OWN chain plus one jump from a built-in chain, and
# never touch a foreign rule. We do the same. This is deliberately NOT a `-m comment` tag: the target
# kernel (Linux 4.9 on the C100X, verified against the firmware sample) ships NO xt_comment match — the
# userspace parser exists but the kernel REJECTS a `-m comment` rule — so a comment tag would leave :8554
# permanently closed on the real hardware. A named chain needs no match module and works on every kernel.
# Ownership is proven, not just named: we manage FW_CHAIN only when WE created it this boot, recorded by a
# boot-scoped marker (FW_OWN, tmpfs — cleared every reboot together with the ruleset). A fixed chain name
# is only a namespace convention; if a `GO2RTC` chain already exists when we first run (a foreign chain we
# did not create), we leave it — and the port — entirely alone rather than flush someone else's chain. So
# we never touch a rule we do not own. Reconciliation is otherwise STATELESS: every watchdog pass
# re-asserts our chain's contents from scratch (flush + repopulate), so the chain itself is the state —
# nothing to drift, and a DHCP subnet change is handled for free. (A second CAP_NET_ADMIN manager could
# still rewrite the firewall wholesale, but that actor already fully controls netfilter — the same
# boundary Docker/kube-proxy accept.)
CAM_PORT=8554
CAM_IFACE=wlan0
FW_CHAIN=GO2RTC
FW_OWN=/var/run/go2rtc.fwown

# Ensure the INPUT jump to our chain exists AND sits LAST — appended AFTER the panel's factory/admin INPUT
# filters (e.g. the conntrack `--ctstate INVALID -j DROP` guard installed by /etc/network/if-pre-up.d/
# iptables) but still before the `-P INPUT DROP` policy (evaluated only after all rules). Our ACCEPT
# therefore never lets traffic bypass a factory or admin filter. Merely checking existence is not enough:
# the factory rebuild does `-F INPUT` then many `-A INPUT`, so a watchdog pass that appended our jump
# mid-rebuild would leave it AHEAD of the later-restored filters. So if the jump is missing OR not the
# last INPUT rule, drain it and re-append at the end — the next pass self-corrects the position within one
# watchdog interval. Steady state (already last) mutates nothing. Non-matching packets RETURN from
# our chain and continue INPUT, so the jump never disturbs other traffic.
fw_jump() {
	# Capture the listing FIRST and change nothing if it fails — an inspection error (xtables lock,
	# resource) must not read as "jump out of place" and trigger a destructive drain+re-append that a
	# failing backend might then leave with no jump at all.
	inp=$(iptables -w 5 -S INPUT 2>/dev/null) || return 0
	n=$(printf '%s\n' "$inp" | grep -c -- "^-A INPUT -j $FW_CHAIN\$")
	last=$(printf '%s\n' "$inp" | tail -n 1)
	# Invariant: EXACTLY ONE INPUT jump, and it is LAST (after the factory/admin filters, before the policy
	# DROP). Already satisfied → nothing to do. The count check matters: if a stale duplicate remains it is
	# NOT early-returned, so a failed cleanup below self-heals on a later pass.
	[ "$n" -eq 1 ] && [ "$last" = "-A INPUT -j $FW_CHAIN" ] && return 0
	# Ensure a jump exists at the END: if ours isn't already last, APPEND a fresh one FIRST so a jump always
	# exists during the swap; if that append fails, keep what we have and retry next pass.
	if [ "$last" != "-A INPUT -j $FW_CHAIN" ]; then
		iptables -w 5 -A INPUT -j "$FW_CHAIN" 2>/dev/null || return 0
	fi
	# Drop EARLIER duplicate jumps one at a time, RE-COUNTING the LIVE ruleset each iteration so we can
	# never delete below one — even if a concurrent factory `-F INPUT` flushed the old jumps after our
	# listing (a stale count would otherwise delete the freshly appended jump). `-D` removes the
	# first match, so the last jump survives until exactly one remains. Stop on any failure and retry next
	# pass (a listing failure yields count 0 and also stops, never over-deleting).
	while [ "$(iptables -w 5 -S INPUT 2>/dev/null | grep -c -- "^-A INPUT -j $FW_CHAIN\$")" -gt 1 ]; do
		iptables -w 5 -D INPUT -j "$FW_CHAIN" 2>/dev/null || break
	done
}

# Probe whether OUR chain exists, distinguishing a CONFIRMED-absent chain from an inspection error — per
# iptables(8) DIAGNOSTICS a nonzero exit can also mean a resource/lock error, not just a missing chain.
# Prints nothing; returns: 0 = exists, 1 = confirmed absent ("No chain…"), 2 = could not determine. A
# caller must never treat 2 as "absent" (that would relinquish ownership of a chain that may still be ours).
fw_chain_exists() {
	out=$(iptables -w 5 -S "$FW_CHAIN" 2>&1) && return 0
	case "$out" in *"No chain"*) return 1 ;; esac
	return 2
}

# PIDs of the actual daemon. `pgrep -x go2rtc` matches the daemon binary; the init
# script's own shell process has comm "go2rtcd" (the script name), so it is not
# matched here. Keep btmqttd's readlink filter anyway — belt-and-suspenders against
# any other "go2rtc"-named process: only PIDs whose executable is $DAEMON count.
daemon_pids() {
	for p in $(/usr/bin/pgrep -x "$NAME" 2>/dev/null); do
		[ "$(readlink /proc/"$p"/exe 2>/dev/null)" = "$DAEMON" ] && echo "$p"
	done
}
is_running() { [ -n "$(daemon_pids)" ]; }

# Acquire the mutex (mkdir is atomic). Critical sections are short (never a
# kill+wait), so retry briefly; steal a stale lock after ~10s so a process killed
# mid-operation cannot wedge the service forever.
acquire() {
	i=0
	while ! mkdir "$LOCKDIR" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 10 ]; then rmdir "$LOCKDIR" 2>/dev/null; else sleep 1; fi
	done
}
release() { rmdir "$LOCKDIR" 2>/dev/null; }

# Signal every daemon instance. Defaults to SIGTERM; pass "-9" to force. (Without
# a default an argument-less call would run `kill "" <pid>` — an invalid signal
# operand that silently signals nothing.)
kill_all() {
	sig=${1:--TERM}
	for p in $(daemon_pids); do kill "$sig" "$p" 2>/dev/null; done
}

# Open the RTSP media port (issue #120, decision #4: least-privilege + LAN source-restrict). Idempotent,
# stateless and DHCP-proof. Ownership first: if FW_CHAIN already exists but we did NOT create it this boot
# (no FW_OWN marker), it is a FOREIGN chain — return without touching it or the port. Otherwise ensure OUR
# chain exists (creating it claims ownership for this boot; also recreates it if the panel destroyed it),
# then reconcile its contents to exactly one ACCEPT for tcp/CAM_PORT from CAM_IFACE's own subnet (derived
# at runtime; iptables masks the address to its /prefix). With NO address yet (the boot race before DHCP,
# or a lease drop) the desired state is an EMPTY chain — the port stays closed, never opened interface-
# wide — and a later pass fills it once an address appears.
#
# ZERO-WRITE IN STEADY STATE (task #42). Earlier this ALWAYS did `-F` + `-A` every watchdog pass (~60s).
# That per-pass write churn is the collision source: our `-w 5` mutating calls could HOLD the xtables lock
# across the factory firewall's LOCK-LESS `-F INPUT; -A INPUT …` rebuild (in /etc/network/if-pre-up.d/
# iptables, no `-w`), making the factory's own `-A INPUT` calls FAIL SILENTLY — dropping factory rules
# (FTP-over-USB reflash, security DROPs, even SSH). So we now WRITE ONLY WHEN THE STATE DIFFERS: if OUR
# chain already holds exactly the one desired ACCEPT for the current subnet (address present) OR is already
# empty (no address), we make NO iptables writes at all — just re-assert the (itself zero-write when
# already-last) INPUT jump and return. A DHCP subnet change, a missing/extra rule, or a chain we just
# created still triggers the flush+repopulate path. The if-up.d hook (go2rtc-net-hook → `fw-reassert`)
# re-asserts sequentially right AFTER the factory rebuild for boot/WiFi-reconnect; this zero-write
# reconciliation is the watchdog-driven safety net for every other trigger.
firewall_open() {
	command -v iptables >/dev/null 2>&1 || return 0
	fw_chain_exists; fw_rc=$?
	if [ "$fw_rc" -eq 2 ]; then
		return 0                                # inspection error — chain state unknown; change nothing, retry
	elif [ "$fw_rc" -eq 0 ]; then
		[ -e "$FW_OWN" ] || return 0            # chain exists but is foreign (not created by us) — leave it
	else
		# Chain CONFIRMED absent (fresh boot, or the panel destroyed the chain we owned). Claim ownership
		# BEFORE (re)creating it — marker-first — so a failed marker write bails here (reaching the lines
		# below therefore PROVES the marker file is writable). If -N then fails because a GO2RTC chain
		# appeared in the race window between the probe and here, it is not one we created: RELINQUISH the
		# marker (the rm cannot fail — same writable file, same pass) and bail, so the next pass treats the
		# newly appeared chain as foreign and never flushes it.
		: > "$FW_OWN" 2>/dev/null || return 0
		iptables -w 5 -N "$FW_CHAIN" 2>/dev/null || { rm -f "$FW_OWN" 2>/dev/null || true; return 0; }
	fi
	# The desired LAN source for CAM_IFACE's CURRENT address (empty when there is no address yet).
	lan=$(ip -4 addr show "$CAM_IFACE" 2>/dev/null | awk '/inet /{print $2; exit}')
	# Count OUR chain's current rules once. Capture the LISTING STATUS separately and set n=-1 on failure:
	# a plain `grep -c` yields 0 both for an empty chain AND a failed listing, so with no address the fast
	# path below would read that 0 as "already empty/correct" and return, leaving a stale rule in place. An
	# inspection error must instead fall through to the flush path (which itself bails on a contended `-F`).
	if fw_list=$(iptables -w 5 -S "$FW_CHAIN" 2>/dev/null); then
		n=$(printf '%s\n' "$fw_list" | grep -c -- "^-A ")
	else
		n=-1                            # inspection error — never read as "already correct"
	fi
	# ZERO-WRITE FAST PATH: if the chain is ALREADY in the desired state, perform NO iptables writes — only
	# re-assert the jump and return. `-C` canonicalizes arg order / `-m tcp` / subnet masking, so it matches
	# the rule iptables actually stored, not just its textual form. Desired state is either exactly our one
	# ACCEPT for the current subnet (address present) or an empty chain (no address yet).
	if [ -n "$lan" ]; then
		[ "$n" -eq 1 ] && iptables -w 5 -C "$FW_CHAIN" -i "$CAM_IFACE" -p tcp --dport "$CAM_PORT" \
			-s "$lan" -j ACCEPT 2>/dev/null && { fw_jump; return 0; }
	else
		[ "$n" -eq 0 ] && { fw_jump; return 0; }
	fi
	# State DIFFERS (chain empty-but-needs-a-rule, wrong/changed subnet, extra rules, or a rule that should
	# be gone): re-assert from scratch. Require a SUCCESSFUL flush before repopulating: if the xtables lock
	# is contended past the wait and `-F` fails, abort this pass rather than append a second ACCEPT on top
	# of the stale one (a later pass retries). The `-w 5` on every mutating call waits up to 5s for the lock
	# (supported on the target, and under the ~10s lock-steal threshold), so a spurious failure while the
	# panel touches iptables is rare.
	iptables -w 5 -F "$FW_CHAIN" 2>/dev/null || return 0
	# shellcheck disable=SC2015  # `[ -n "$lan" ] && add || true`: with no address we intentionally leave
	# the chain empty (port closed) and still reach fw_jump — `|| true` only neutralizes the guard's exit.
	[ -n "$lan" ] && iptables -w 5 -A "$FW_CHAIN" -i "$CAM_IFACE" -p tcp --dport "$CAM_PORT" -s "$lan" \
		-j ACCEPT 2>/dev/null || true
	fw_jump
}

# Close the media port again (service stopped/disabled/not running): tear down everything WE created and
# nothing else. Only act if we own the chain (FW_OWN marker) — a foreign GO2RTC chain is never touched.
# Remove the INPUT jump(s) to our chain, then flush and delete the chain (the jump must go before `-X`,
# which refuses a referenced chain), and drop the ownership marker last. `-X` fails harmlessly if the
# chain is absent, so a transient failure just leaves our own empty chain to be reaped on a later pass.
firewall_close() {
	command -v iptables >/dev/null 2>&1 || return 0
	[ -e "$FW_OWN" ] || return 0
	while iptables -w 5 -D INPUT -j "$FW_CHAIN" 2>/dev/null; do :; done
	iptables -w 5 -F "$FW_CHAIN" 2>/dev/null || true
	iptables -w 5 -X "$FW_CHAIN" 2>/dev/null || true
	# Drop ownership ONLY when a SUCCESSFUL listing confirms both the chain and its INPUT jump are gone. A
	# failed listing (inspection error) or a still-present chain/jump keeps FW_OWN so a later close/respawn
	# retries the teardown — an inspection failure must never be read as "absent". One `-S`
	# lists the whole filter table (chain declarations `-N …` and rules `-A …`), so it covers both; capture
	# it once and bail on failure rather than piping (a failed `-S` into grep would look empty = "gone").
	rules=$(iptables -w 5 -S 2>/dev/null) || return 0
	printf '%s\n' "$rules" | grep -q -- "^-A INPUT -j $FW_CHAIN\$" && return 0   # our INPUT jump still present
	printf '%s\n' "$rules" | grep -q -- "^-N $FW_CHAIN\$" && return 0            # chain still declared
	rm -f "$FW_OWN" 2>/dev/null || true
}

# (Re)assemble the tmpfs RUNTIME SDP go2rtc reads. Recreate the tmpfs dir (mkdir -p — /var/run is
# cleared every boot), then either copy the read-only template verbatim or, when a learned sprop value
# FOR THE CURRENT BRANCH is persisted (see the branch gate below) AND the template does not already
# carry one, splice `sprop-parameter-sets=<value>;` into the fmtp line immediately after
# `packetization-mode=1;` — the exact order Go2RtcConfig.BuildOnDeviceSdp / sprop.rs use. Written via a
# temp file + atomic mv so go2rtc never reads a half-written SDP. Best-effort: a missing template (a
# non-camera image) is a no-op, and any failure leaves whatever runtime SDP already existed rather than
# truncating it.
assemble_sdp() {
	[ -f "$TEMPLATE_SDP" ] || return 0
	mkdir -p "$RUNTIME_SDP_DIR" 2>/dev/null || return 0
	tmp="$RUNTIME_SDP.tmp.$$"
	# Resolve the sprop value ONLY when the persisted record's branch matches the current install's
	# CAMERA_BRANCH (task #41). The record is `<branch>\t<value>`: cut -f1 is the branch (TAB is cut's
	# default delimiter), cut -f2- the value. A legacy bare value (no TAB) makes cut -f1 == the whole
	# line, which won't equal a single-digit branch, so it is ignored and btmqttd re-learns it.
	sprop=""
	if [ -s "$SPROP_FILE" ]; then
		rec=$(head -n 1 "$SPROP_FILE" 2>/dev/null)
		rec_branch=$(printf '%s' "$rec" | cut -f1)
		rec_value=$(printf '%s' "$rec" | cut -f2- | sed 's/[[:space:]]*$//')
		# Resolve the CURRENT branch and splice ONLY when it unambiguously matches the installer's
		# canonical value, ERRING TOWARD NOT SPLICING otherwise. Rather than reimplement config.rs's
		# full shell-quoting parser in sh (a losing game), we adopt a provably-safe rule: this yields a
		# concrete 0/1 ONLY for a pure-integer assignment — the exact form the installer writes
		# (`CAMERA_BRANCH=0`/`=1`) — and anything else (quoted, `export`-prefixed, non-numeric, absent)
		# yields the sentinel `none`, which matches no record so nothing is spliced and btmqttd re-learns.
		# We DO mirror the two parse_env behaviours that could otherwise flip a real match: the LAST
		# assignment wins (parse_env builds a map), and an optional `export ` prefix / surrounding
		# whitespace / inline `#` comment are ignored. Leading zeros are stripped so 00 -> 0 and 01 -> 1
		# compare as numbers, and > 1 clamps to 1 — matching parse::<u8>().filter(|b| *b <= 1). Safety
		# invariant: whenever this yields 0 or 1, config.rs provably yields the SAME value, so go2rtcd
		# can never splice a value for a branch btmqttd is not actually running.
		# Match a CAMERA_BRANCH assignment the way config.rs's parse_env recognizes the KEY, so tail -n 1
		# picks the true LAST assignment (config.rs last-wins) instead of skipping later lines it can't
		# see: strip leading line whitespace (line.trim()), a LITERAL `export ` prefix (strip_prefix
		# ("export ") matches ONE space — `export<TAB>…` is not an export line there and must NOT resolve),
		# then allow whitespace around the key and the `=` (key.trim()). The value is cleaned + integer-
		# validated below; a non-canonical value still falls to the `none` sentinel.
		cur_branch=$(sed -n 's/^[[:space:]]*//; s/^export //; s/^[[:space:]]*CAMERA_BRANCH[[:space:]]*=\(.*\)$/\1/p' "$CONF_FILE" 2>/dev/null | tail -n 1)
		cur_branch=$(printf '%s' "$cur_branch" | sed 's/^[[:blank:]]*//; s/[[:blank:]]#.*$//; s/[[:blank:]]*$//')
		case "$cur_branch" in
			'' | *[!0-9]*) cur_branch=none ;;   # absent / quoted / export-only / non-integer => never match
			*)
				case "$(printf '%s' "$cur_branch" | sed 's/^0*//')" in
					'') cur_branch=0 ;;         # all-zero digits (0, 00, 000, …) => numeric 0
					*) cur_branch=1 ;;          # 1/01/… or any value > 1 => 1 (config.rs clamps > 1 to 1)
				esac
				;;
		esac
		[ "$rec_branch" = "$cur_branch" ] && sprop="$rec_value"
	fi
	if [ -n "$sprop" ] && ! grep -q 'sprop-parameter-sets=' "$TEMPLATE_SDP"; then
		# Escape sed replacement metacharacters (\ & /) — a base64 sprop value can contain '/' and '+'.
		esc=$(printf '%s' "$sprop" | sed 's/[\\&/]/\\&/g')
		sed "s/packetization-mode=1;/packetization-mode=1;sprop-parameter-sets=${esc};/" \
			"$TEMPLATE_SDP" > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
	else
		cp "$TEMPLATE_SDP" "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
	fi
	mv "$tmp" "$RUNTIME_SDP" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
}

# Launch the daemon iff enabled (no marker) and not already running. Caller holds
# the lock, so this cannot race a concurrent start/stop/respawn. Returns 0 ONLY when
# it actually backgrounded a new instance (disabled / already-running return 1), so
# the caller can `wait_running` for a just-launched child before deciding the firewall.
launch_if_enabled() {
	[ -e "$DISABLED" ] && return 1
	is_running && return 1
	if [ -L "$LOGDIR" ] || { [ -e "$LOGDIR" ] && [ ! -d "$LOGDIR" ]; }; then
		rm -f "$LOGDIR"
	fi
	mkdir -p "$LOGDIR" 2>/dev/null
	chmod 700 "$LOGDIR" 2>/dev/null
	[ -L "$LOGFILE" ] && rm -f "$LOGFILE"
	# Assemble the tmpfs runtime SDP right before launch, so go2rtc reads a fresh copy each time it
	# (re)starts — reflecting any sprop learned+persisted since the last launch.
	assemble_sdp
	"$DAEMON" -config "$CONFIG" >> "$LOGFILE" 2>&1 &
	return 0
}

# Poll briefly for a just-backgrounded daemon to exec $DAEMON. Without this, the is_running check right
# after a launch can race the child's exec and read "down", so a manual start/restart would close the
# media port until the next watchdog pass ~60s later. Only ever called after launch_if_enabled
# reports it launched, so steady-state respawns (already running) never sleep. Bounded to ~5s — well
# under the ~10s lock-steal threshold — then returns is_running's verdict so a genuinely failed launch
# still ends with the port closed.
wait_running() {
	i=0
	while ! is_running && [ "$i" -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	is_running
}

case "$1" in
	start)
		# Operator/boot intent: enable the service, launch, then open the media port iff it came up.
		acquire
		rm -f "$DISABLED" 2>/dev/null
		launch_if_enabled && wait_running
		if is_running; then firewall_open; else firewall_close; fi
		release
		echo "$NAME started"
		;;
	respawn)
		# Supervisor-only reconcile (bt_service_watchdog). Under the lock: enforce
		# the desired state - if stopped (marker present) kill any lingering or
		# racily-started instance and close the port; otherwise (re)launch if it is
		# down and (re)assert the firewall rule. firewall_open runs EVERY pass but is
		# now ZERO-WRITE when :8554 is already correct (task #42) — it only writes to
		# re-open the port after the panel rebuilt/flushed its chain, so it is the
		# safety net that catches any trigger the if-up.d hook did not. The rule is
		# tied to the daemon actually running, so a persistently failed launch (missing
		# binary/config) leaves no open port. Never clears the marker, so it
		# cannot undo an operator's `stop`.
		acquire
		if [ -e "$DISABLED" ]; then
			kill_all
			firewall_close
		else
			launch_if_enabled && wait_running
			if is_running; then firewall_open; else firewall_close; fi
		fi
		release
		;;
	fw-reassert)
		# Firewall-ONLY reconcile (task #42), the single source of truth the if-up.d hook
		# (go2rtc-net-hook) calls right after the factory firewall rebuild on a wlan0 bring-up.
		# It re-asserts our GO2RTC rule sequentially — no daemon racing the factory's lock-less
		# INPUT writes — and is idempotent + zero-write in steady state (see firewall_open). It
		# must NEVER launch or kill the daemon: only the firewall is touched. Under the lock, if
		# the service is ENABLED (no marker) AND actually running, (re)assert the rule; otherwise
		# tear it down (matches the running-state coupling used by start/respawn).
		acquire
		if [ ! -e "$DISABLED" ] && is_running; then
			firewall_open
		else
			firewall_close
		fi
		release
		;;
	stop)
		# Operator intent: disable, then terminate. Set the marker FIRST (under the
		# lock) so no concurrent respawn relaunches, then kill every instance and
		# wait for graceful shutdown, escalating to SIGKILL. Killing outside the lock
		# keeps the lock hold short; the marker already suppresses respawn.
		acquire
		touch "$DISABLED" 2>/dev/null
		release
		printf '%s' "Stopping $NAME... "
		i=0
		while is_running && [ "$i" -lt 8 ]; do
			kill_all
			sleep 1
			i=$((i + 1))
		done
		is_running && kill_all -9
		# Close the media port UNDER the lock so the state/rule cleanup can't interleave with a concurrent
		# `start`'s firewall_open, and only if we are still the desired-stopped state — an operator `start`
		# during this shutdown window clears DISABLED and reopens the port, so we must not tear its rule
		# down. The kill loop above stays outside the lock (short hold, matching btmqttd).
		acquire
		[ -e "$DISABLED" ] && firewall_close
		release
		echo "done"
		;;
	status)
		if is_running; then
			echo "$NAME is running (PID $(daemon_pids | head -n 1))"
		elif [ -e "$DISABLED" ]; then
			echo "$NAME is stopped (disabled for maintenance)"
			exit 3
		else
			echo "$NAME is NOT running"
			exit 1
		fi
		;;
	restart)
		# `stop` sets the marker + waits for exit; `start` clears it + relaunches.
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|status|restart|respawn|fw-reassert}"
		exit 1
		;;
esac

exit 0
