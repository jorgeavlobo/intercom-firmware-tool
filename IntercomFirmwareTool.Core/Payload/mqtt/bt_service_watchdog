#!/bin/sh
### BEGIN INIT INFO
# Provides:          bt-service-watchdog
# Required-Start:    $network dropbear
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: BTicino service watchdog
# Description:       Keeps THIS TOOL's own daemons alive — dropbear (SSH), which
#                    bt_daemon stops when the app stack comes up, and the btmqttd
#                    MQTT bridge — restarting them if they die. Deliberately does
#                    NOT supervise the core BTicino services (scsserver, mosquitto,
#                    the bt_daemon app stack); the device manages those itself, and
#                    restarting them from here corrupts the running stack.
### END INIT INFO
#
# MIT-licensed reimplementation of fquinto's mqtt_scripts/bt_service_watchdog
# (GPL-2.0) for IntercomFirmwareTool. Logs live in a root-only directory rather
# than a predictable world-writable /tmp path (symlink-attack safe).
PATH=/sbin:/usr/sbin:/usr/bin:/bin
PIDFILE=/var/run/bt_service_watchdog.pid
LOGDIR=/var/log/btmqttd
LOGFILE=$LOGDIR/bt_watchdog.log
INTERVAL=60

log() { echo "$(date): $1" >> "$LOGFILE"; }

# SSH is only "up" if something is LISTENING on port 22 - a per-connection
# dropbear session fork keeps the process name alive even after the master
# listener has died, so a plain `pgrep -x dropbear` would wrongly report SSH
# healthy and never restart it. Check the listening socket instead, with a
# process-name fallback for a box where neither netstat nor ss is available.
ensure_dropbear() {
	if command -v netstat > /dev/null 2>&1; then
		listening=$(netstat -ltn 2>/dev/null | grep -qE '[:.]22[[:space:]]' && echo yes)
	elif command -v ss > /dev/null 2>&1; then
		listening=$(ss -ltn 2>/dev/null | grep -qE '[:.]22[[:space:]]' && echo yes)
	else
		listening=$(/usr/bin/pgrep -x dropbear > /dev/null 2>&1 && echo yes)
	fi
	if [ "$listening" != yes ]; then
		log "dropbear not listening on :22 - restarting"
		/etc/init.d/dropbear start >> "$LOGFILE" 2>&1
	fi
}

watchdog_loop() {
	# Root-only log dir; drop any pre-existing symlink at the dir OR the log
	# paths (before mkdir/chmod) so a symlink attack cannot redirect root's
	# writes or have chmod affect a symlink target.
	if [ -L "$LOGDIR" ] || { [ -e "$LOGDIR" ] && [ ! -d "$LOGDIR" ]; }; then
		rm -f "$LOGDIR"
	fi
	mkdir -p "$LOGDIR" 2>/dev/null
	chmod 700 "$LOGDIR" 2>/dev/null
	[ -L "$LOGFILE" ] && rm -f "$LOGFILE"

	log "BTicino service watchdog started (PID $$)"
	while : ; do
		# Supervise ONLY the daemons this tool adds. dropbear (SSH) is legitimately
		# ours to keep alive: bt_daemon stops it whenever the app stack comes up, so
		# without this SSH would vanish for good the first time the intercom starts.
		#
		# We must NOT supervise the core BTicino services (scsserver, mosquitto, the
		# bt_daemon app stack) — the device already manages those. An earlier version
		# ran `ensure scsserver /etc/init.d/bt_daemon-apps.sh start`, which relaunched
		# the ENTIRE app stack whenever scsserver was momentarily absent (e.g. during
		# the up-to-100s Cortex-M0 wait at boot). That started a SECOND bt_daemon /
		# openserver that collided with the first on the SCS socket ("Create socket to
		# SCS server failed"), taking the screen and gate/intercom controls down about
		# one INTERVAL (~60s) after every boot while SSH survived. Never do that again.
		ensure_dropbear

		# btmqttd is the native single-connection MQTT bridge daemon (issue #32),
		# managed by its own init script (/etc/init.d/btmqttd). Delegate supervision
		# to the init script's `respawn`, which — atomically under its own lock —
		# reconciles the process to the desired state: (re)launch if it is enabled
		# and down, or enforce an operator's `stop` (DISABLED marker) by terminating
		# any lingering instance. Running it every pass (not only when down) is what
		# honors a maintenance stop and heals any boot-time start race.
		/etc/init.d/btmqttd respawn >> "$LOGFILE" 2>&1

		# go2rtc is the on-device camera media server (issue #120), managed by its own
		# init script. It is installed ONLY on the on-device camera path, so guard on the
		# script's presence: on a non-camera image the file is absent and this is a no-op
		# (no spurious "not found" every pass). Same respawn contract as btmqttd above —
		# reconcile the process to the DISABLED marker each pass.
		[ -x /etc/init.d/go2rtcd ] && /etc/init.d/go2rtcd respawn >> "$LOGFILE" 2>&1

		# Keep the log from growing without bound: trim to 50 KB past 100 KB.
		if [ -f "$LOGFILE" ]; then
			size=$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)
			if [ "$size" -gt 102400 ]; then
				tail -c 51200 "$LOGFILE" > "${LOGFILE}.tmp" && mv "${LOGFILE}.tmp" "$LOGFILE"
			fi
		fi

		sleep "$INTERVAL"
	done
}

case "$1" in
	start)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "BTicino service watchdog already running (PID $(cat "$PIDFILE"))"
			exit 0
		fi
		printf '%s' "Starting BTicino service watchdog... "
		watchdog_loop &
		echo $! > "$PIDFILE"
		echo "done (PID $!)"
		;;
	stop)
		printf '%s' "Stopping BTicino service watchdog... "
		if [ -f "$PIDFILE" ]; then
			kill "$(cat "$PIDFILE")" 2>/dev/null
			rm -f "$PIDFILE"
			echo "done"
		else
			echo "not running"
		fi
		;;
	status)
		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
			echo "BTicino service watchdog is running (PID $(cat "$PIDFILE"))"
		else
			echo "BTicino service watchdog is NOT running"
			exit 1
		fi
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|status|restart}"
		exit 1
		;;
esac

exit 0
