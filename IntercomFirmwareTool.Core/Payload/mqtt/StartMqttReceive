#!/bin/sh
# StartMqttReceive - apply commands received over MQTT to the unit.
#
# Holds a PERSISTENT subscription to $TOPIC_RX (mqtt_sub_stream) and dispatches each
# message: a raw OpenWebNet frame ("*...##") is forwarded to the local gateway
# (nc 127.0.0.1 30006); anything else is treated as a JSON command. The JSON command
# channel (read_file / write_file / execute_command) is a root-level remote-control
# surface and is DISABLED unless the operator opted in AND the client is authenticated
# (see remote_shell_allowed in mqtt_common.sh).
#
# The same long-lived session also carries the retained 'offline' last will, so it is
# the single owner of MQTT availability (there is no separate presence holder). See
# mqtt_sub_stream in mqtt_common.sh for why one persistent session replaced the old
# one-shot (-C 1) receiver + presence pair.
#
# Because messages are consumed line-by-line from the subscription stream, a command
# must be a SINGLE LINE: OpenWebNet frames already are, and JSON commands must be
# published as COMPACT (one-line) JSON. Multi-line file content is still supported —
# carry it as a JSON "\n"-escaped string inside that one-line payload (jq decodes the
# escapes). An embedded literal newline would split the payload into fragments.
#
# MIT-licensed reimplementation of fquinto's mqtt_scripts/StartMqttReceive
# (GPL-2.0) for IntercomFirmwareTool. Fixes over the original: the arbitrary
# command channel is gated and refused on an unauthenticated broker; a persistent
# subscription (no per-message reconnect) closes the command-loss window and avoids
# the tight loop that pegged the CPU when the broker was unreachable.
PATH=/sbin:/usr/sbin:/usr/bin:/bin
. /etc/tcpdump2mqtt/mqtt_common.sh

OWN_PORT=30006

handle_json() {
	msg="$1"
	if ! remote_shell_allowed; then
		echo "Ignored JSON command: remote command channel is disabled (needs ALLOW_REMOTE_SHELL=1 and an authenticated broker: user/pass or mutual TLS)."
		return
	fi
	if ! command -v jq > /dev/null 2>&1; then
		echo "JSON command ignored: jq is not installed."
		return
	fi
	command=$(printf '%s' "$msg" | jq -r '.command // empty' 2>/dev/null)
	file_path=$(printf '%s' "$msg" | jq -r '.file_path // empty' 2>/dev/null)
	data=$(printf '%s' "$msg" | jq -r '.data // empty' 2>/dev/null)
	case "$command" in
		read_file)
			[ -n "$file_path" ] || { echo "read_file: missing file_path"; return; }
			# Cap the payload (256 KB): a huge or special file (e.g. under /proc)
			# must not balloon memory or the MQTT message and wedge the device.
			# `--` so a path beginning with '-' is not taken as a head option.
			content=$(head -c 262144 -- "$file_path" 2>/dev/null)
			mqtt_pub -t "${TOPIC_FILE_CONTENT}" -m "$content"
			;;
		write_file)
			[ -n "$file_path" ] || { echo "write_file: missing file_path"; return; }
			# Cap the write (256 KB, same as read_file) so an oversized message
			# can't fill flash. Write to a temp file in the same directory and
			# rename, so a crash mid-write can't leave a partial (e.g. a config).
			tmp="${file_path}.tmp.$$"
			# `--` throughout: file_path (and thus tmp) comes from the MQTT
			# payload and could begin with '-'. umask 077 so the temp is never
			# briefly world-readable; then match the existing file's mode so
			# replacing e.g. the 0600 config does not loosen its permissions
			# (chmod is best-effort — on failure the temp stays 0600, which is
			# restrictive, not a loosening).
			if ( umask 077; printf '%s' "$data" | head -c 262144 > "$tmp" ); then
				if [ -e "$file_path" ]; then
					# Preserve the target's mode AND owner/group, so replacing a
					# file owned by e.g. bticino under /home/bticino doesn't
					# silently reassign it to root (both best-effort).
					mode=$(stat -c '%a' "$file_path" 2>/dev/null)
					[ -n "$mode" ] && chmod "$mode" -- "$tmp" 2>/dev/null
					own=$(stat -c '%u:%g' "$file_path" 2>/dev/null)
					[ -n "$own" ] && chown "$own" -- "$tmp" 2>/dev/null
				fi
				mv -- "$tmp" "$file_path"
			else
				rm -f -- "$tmp"
			fi
			;;
		execute_command)
			# Cap captured output at 256 KB: closing the pipe also SIGPIPEs a
			# runaway/never-ending command, so it can't exhaust memory or blow
			# past the broker's message limit.
			#
			# stdin from /dev/null: this runs inside the `mqtt_sub_stream | while read`
			# loop, so the child would otherwise inherit the SUBSCRIPTION pipe as its
			# stdin — a command that reads stdin (cat, read, grep without a file) could
			# then swallow or block on later MQTT payloads, dropping commands (and even
			# echoing them back in TOPIC_CMD_RESULT).
			result=$(sh -c "$data" </dev/null 2>&1 | head -c 262144)
			mqtt_pub -t "${TOPIC_CMD_RESULT}" -m "$result"
			;;
		*)
			echo "Unsupported command: $command"
			;;
	esac
}

# Dispatch one received line: forward a raw OpenWebNet frame to the gateway, else
# hand it to the JSON command handler.
dispatch() {
	rxcmd="$1"
	# Ignore empty lines (a genuinely empty MQTT message, or a blank line): they are
	# neither a frame nor JSON, so skip them instead of letting handle_json log a
	# spurious "Unsupported command" for each one.
	[ -n "$rxcmd" ] || return

	# printf, not echo: an MQTT payload starting with -n or containing backslashes
	# would be mangled by some echo implementations.
	if printf '%s\n' "$rxcmd" | grep -qE '^\*.*##$'; then
		# Raw OpenWebNet frame - forward to the local gateway. Use an explicit
		# 127.0.0.1 (the openserver is mapped to loopback): busybox nc does not
		# reliably accept the "0" host shorthand that some netcats read as
		# localhost.
		printf '%s\n' "$rxcmd" | nc 127.0.0.1 "$OWN_PORT"
	else
		handle_json "$rxcmd"
	fi
}

# Probe mosquitto_sub's durable-session (-c) support ONCE here in the parent shell, so
# the cached MQTT_SUB_CLEAN is inherited by every mqtt_sub_stream pipeline subshell
# below instead of re-running "mosquitto_sub --help" on each reconnect.
mqtt_detect_clean

# Clear any STRAY retained message on a concrete command topic, ONCE at startup.
# Commands must be published NON-retained; the persistent subscription's -R only
# suppresses messages delivered WITH the retain bit set (a fresh SUBSCRIBE), but MQTT
# clears that bit for a message delivered to an already-established subscription — so a
# command mistakenly published *retained* would be delivered (retain=0) and executed,
# and with a durable session could also be queued and replayed on reconnect. Actively
# deleting the broker's retained value removes that source (an empty retained publish
# clears it). Only meaningful for a CONCRETE topic: a wildcard ("+"/"#") or shared
# ("$share/…") TOPIC_RX can't be published to. Best-effort (needs publish rights on the
# topic); if the empty payload loops back to us it's ignored by dispatch. Robust
# app-level command de-duplication is future work — see #12 (structured JSON) and #32.
case "${TOPIC_RX}" in
	*[+#]* | '$share/'*) : ;;
	*) mqtt_pub -r -t "${TOPIC_RX}" -n > /dev/null 2>&1 ;;
esac

fail=0
while : ; do
	# Persistent subscription: mqtt_sub_stream streams every command AND holds the
	# retained 'offline' last will. It reconnects internally after a broker blip, so
	# it normally exits only on a HARD failure (e.g. the broker is unreachable at
	# startup, before the first connect). -r on read preserves backslashes so a JSON
	# "\n" escape reaches jq intact; IFS= keeps leading/trailing spaces in the line.
	start=$(date +%s)
	mqtt_sub_stream | while IFS= read -r rxcmd; do
		dispatch "$rxcmd"
	done

	# The pipeline ended: mqtt_sub_stream exited. If the subscription had stayed up a
	# while it was healthy (a normal reconnect-and-drop), so retry immediately; a
	# quick exit means the broker is unreachable, so back off (capped) to avoid
	# spinning. date +%s (busybox) avoids the bash-only SECONDS.
	end=$(date +%s)
	if [ $((end - start)) -ge 60 ]; then
		fail=0
	else
		fail=$((fail + 1))
		[ $fail -gt 6 ] && fail=6
	fi
	sleep $((fail * 5))
done
