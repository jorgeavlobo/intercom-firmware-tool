#!/bin/sh
# TcpDump2Mqtt - orchestrator for the BTicino MQTT bridge.
#
# Keeps the sender (bus -> MQTT), receiver (MQTT -> bus) and key-press publisher
# running, publishes online/start status, and recovers after a network outage.
#
# MIT-licensed reimplementation of fquinto's mqtt_scripts/TcpDump2Mqtt (GPL-2.0)
# for IntercomFirmwareTool. Fixes over the original: POSIX sh (no bash-only
# "function"); children tracked with pgrep -f on explicit paths; keypress.sh is
# actually installed; auth/TLS composition and validation shared via
# mqtt_common.sh (auth+TLS combine, one-way "CA only" TLS allowed).
PATH=/sbin:/usr/sbin:/usr/bin:/bin
. /etc/tcpdump2mqtt/mqtt_common.sh

kill_by() {
	pids=$(/usr/bin/pgrep -f "$1" 2>/dev/null)
	if [ -n "$pids" ]; then
		# shellcheck disable=SC2086
		kill $pids > /dev/null 2>&1
		echo "Stopped: $1 (PID $pids)"
	fi
}

# Escape regex metacharacters so a topic containing them can't broaden the
# pgrep -f match (killing unrelated processes) or fail to match ours.
re_escape() { printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g'; }

kill_childs() {
	kill_by "/etc/tcpdump2mqtt/StartMqttSend"
	kill_by "/etc/tcpdump2mqtt/StartMqttReceive"
	kill_by "/etc/tcpdump2mqtt/keypress.sh"
	kill_by "/etc/tcpdump2mqtt/filter.py"
	# Our own pipeline children, matched specifically (by our port/topics) so a
	# manual tcpdump or an unrelated mosquitto session on the box is left alone,
	# and so the mosquitto_sub reparented out of the receiver's command
	# substitution does not linger as an orphan across outages.
	kill_by "tcpdump.*dst port 30006"
	kill_by "mosquitto_sub.*$(re_escape "${TOPIC_RX}")"
	kill_by "mosquitto_pub.*$(re_escape "${TOPIC_DUMP}")"
}

exit_handler() {
	echo "TcpDump2Mqtt shutting down."
	kill_childs
	exit 0
}
trap exit_handler INT TERM

# --- Config validation ------------------------------------------------------
# mqtt_common.sh already sourced the config. Check the essentials are coherent.
tls_bad=0
if [ -n "${MQTT_CERTFILE}" ] || [ -n "${MQTT_KEYFILE}" ]; then
	# Mutual TLS: need BOTH the client cert and key, plus a CA to verify the broker.
	{ [ -n "${MQTT_CERTFILE}" ] && [ -n "${MQTT_KEYFILE}" ] && [ -n "${MQTT_CAFILE}" ]; } || tls_bad=1
fi

# Port must be numeric (empty or non-digits would only fail later, deep inside a
# mosquitto retry loop).
case "${MQTT_PORT}" in
	'' | *[!0-9]*) port_bad=1 ;;
	*) port_bad=0 ;;
esac

if [ -z "${MQTT_HOST}" ] || [ "$port_bad" -ne 0 ] || \
   { [ -n "${MQTT_USER}" ] && [ -z "${MQTT_PASS}" ]; } || \
   { [ -n "${MQTT_PASS}" ] && [ -z "${MQTT_USER}" ]; } || \
   [ -z "${TOPIC_RX}" ] || [ -z "${TOPIC_DUMP}" ] || [ -z "${TOPIC_STARTD}" ] || \
   [ -z "${TOPIC_LASTWILL}" ] || [ "$tls_bad" -ne 0 ]; then
	echo "Wrong or missing configuration, please check ${MQTT_CFGFILE}!"
	exit 1
fi

# --- Default gateway (network liveness target) ------------------------------
GWADDR=$(route -n 2>/dev/null | awk '/^0.0.0.0/ && $4 ~ /G/ {print $2; exit}')
if [ -z "$GWADDR" ]; then
	# No default route (e.g. isolated VLAN / static setup). Don't exit — that
	# would just have the watchdog restart us in a loop. Run without the
	# network-liveness probe and keep the services alive by process check.
	echo "No default gateway found; running without the network-liveness probe."
else
	echo "Default gateway resolved as: $GWADDR"
fi
echo "MQTT host ${MQTT_HOST}:${MQTT_PORT}"

echo "Checking for stale processes..."
kill_childs

PING_FAIL_COUNT=0
PING_FAIL_THRESHOLD=3

while : ; do
	# 2 pings, 3s timeout, tolerate brief spikes before declaring the net down.
	# With no gateway to probe, assume up and rely on the process-liveness checks.
	if [ -n "$GWADDR" ]; then
		ping -s 1 -c 2 -W 3 "${GWADDR}" > /dev/null 2>&1
		ping_ok=$?
	else
		ping_ok=0
	fi

	# The flexisipsh patch drops this marker when the SIP stack restarts. The
	# MQTT link is independent of SIP, so just clear it and note it.
	if [ -f /tmp/flexisip_restarted ]; then
		/bin/rm -f /tmp/flexisip_restarted
		echo "Flexisip restarted - MQTT services left running"
	fi

	if [ $ping_ok -ne 0 ]; then
		PING_FAIL_COUNT=$((PING_FAIL_COUNT + 1))
		echo "Network ping failed (${PING_FAIL_COUNT}/${PING_FAIL_THRESHOLD})"
		if [ $PING_FAIL_COUNT -ge $PING_FAIL_THRESHOLD ]; then
			echo "Network confirmed down, restarting MQTT services..."
			PING_FAIL_COUNT=0
			kill_childs
		fi
	else
		PING_FAIL_COUNT=0

		# Liveness by our OWN sender script, not any tcpdump on the box.
		if ! /usr/bin/pgrep -f "/etc/tcpdump2mqtt/StartMqttSend" > /dev/null 2>&1; then
			echo "Starting MQTT sender..."
			/etc/tcpdump2mqtt/StartMqttSend &
			/bin/sleep 5
			/bin/date +"%Y-%m-%dT%H:%M:%S" | mqtt_pub -l -r -t "${TOPIC_STARTD}"
		fi

		if ! /usr/bin/pgrep -f "/etc/tcpdump2mqtt/StartMqttReceive" > /dev/null 2>&1; then
			echo "Starting MQTT receiver..."
			/etc/tcpdump2mqtt/StartMqttReceive &
			/bin/sleep 5
			mqtt_pub -r -t "${TOPIC_LASTWILL}" -m online
		fi

		if [ -x /etc/tcpdump2mqtt/keypress.sh ] && \
		   ! /usr/bin/pgrep -f "/etc/tcpdump2mqtt/keypress.sh" > /dev/null 2>&1; then
			/etc/tcpdump2mqtt/keypress.sh &
		fi
	fi

	/bin/sleep 30
done
