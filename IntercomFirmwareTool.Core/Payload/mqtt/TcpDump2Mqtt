#!/bin/sh
# TcpDump2Mqtt - orchestrator for the BTicino MQTT bridge.
#
# Keeps the sender (bus -> MQTT), receiver (MQTT -> bus) and key-press publisher
# running, publishes online/start status, and recovers after a network outage.
#
# MIT-licensed reimplementation of fquinto's mqtt_scripts/TcpDump2Mqtt (GPL-2.0)
# for IntercomFirmwareTool. Fixes over the original:
#   * POSIX sh (no bash-only "function" keyword);
#   * child processes are tracked with pgrep -f instead of fragile ps|grep|grep;
#   * keypress.sh is actually installed, so the key feature works.
PATH=/sbin:/usr/sbin:/usr/bin:/bin
CFGFILE=/etc/tcpdump2mqtt/TcpDump2Mqtt.conf

kill_by() {
	# kill processes matched by a pgrep -f pattern, quietly.
	pids=$(/usr/bin/pgrep -f "$1" 2>/dev/null)
	if [ -n "$pids" ]; then
		# shellcheck disable=SC2086
		kill $pids > /dev/null 2>&1
		echo "Stopped: $1 (PID $pids)"
	fi
}

kill_childs() {
	kill_by "/etc/tcpdump2mqtt/StartMqttSend"
	kill_by "/etc/tcpdump2mqtt/StartMqttReceive"
	kill_by "/etc/tcpdump2mqtt/keypress.sh"
	kill_by "tcpdump -i lo"
	kill_by "mosquitto_sub -C 1 --will-topic ${TOPIC_LASTWILL}"
}

exit_handler() {
	echo "TcpDump2Mqtt shutting down."
	kill_childs
	exit 0
}
trap exit_handler INT TERM

# --- Config -----------------------------------------------------------------
if ! { [ -f "$CFGFILE" ] && [ -s "$CFGFILE" ]; }; then
	echo "Configuration file missing or empty!"
	exit 1
fi
set -a
. "$CFGFILE"
set +a

# Minimum required config. If MQTT_USER is set, MQTT_PASS must be too; if a CA
# file is set, so must the client cert and key.
if [ -z "${MQTT_HOST}" ] || [ -z "${MQTT_PORT}" ] || \
   { [ -n "${MQTT_USER}" ] && [ -z "${MQTT_PASS}" ]; } || \
   [ -z "${TOPIC_RX}" ] || [ -z "${TOPIC_DUMP}" ] || [ -z "${TOPIC_STARTD}" ] || \
   [ -z "${TOPIC_LASTWILL}" ] || \
   { [ -n "${MQTT_CAFILE}" ] && { [ -z "${MQTT_CERTFILE}" ] || [ -z "${MQTT_KEYFILE}" ]; }; }; then
	echo "Wrong configuration, please check config file!"
	exit 1
fi

mpub() {
	if [ -n "${MQTT_USER}" ]; then
		/usr/bin/mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
			-u "${MQTT_USER}" -P "${MQTT_PASS}" "$@"
	elif [ -n "${MQTT_CAFILE}" ]; then
		/usr/bin/mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
			--cafile "${MQTT_CAFILE}" --cert "${MQTT_CERTFILE}" --key "${MQTT_KEYFILE}" "$@"
	else
		/usr/bin/mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" "$@"
	fi
}

# --- Default gateway (network liveness target) ------------------------------
GWADDR=$(route -n 2>/dev/null | awk '/^0.0.0.0/ && $4 ~ /G/ {print $2; exit}')
if [ -z "$GWADDR" ]; then
	echo "ERROR: Default gateway not found!"
	exit 1
fi
echo "Default gateway resolved as: $GWADDR"
echo "MQTT host ${MQTT_HOST}:${MQTT_PORT}"

echo "Checking for stale processes..."
kill_childs

PING_FAIL_COUNT=0
PING_FAIL_THRESHOLD=3

while : ; do
	# 2 pings, 3s timeout, tolerate brief spikes before declaring the net down.
	ping -s 1 -c 2 -W 3 "${GWADDR}" > /dev/null 2>&1
	ping_ok=$?

	# The flexisipsh patch drops this marker when the SIP stack restarts. The
	# MQTT link is independent of SIP, so just clear it and note it.
	if [ -f /tmp/flexisip_restarted ]; then
		/bin/rm -f /tmp/flexisip_restarted
		echo "Flexisip restarted - MQTT services left running"
	fi

	if [ $ping_ok -ne 0 ]; then
		PING_FAIL_COUNT=$((PING_FAIL_COUNT + 1))
		echo "Network ping failed (${PING_FAIL_COUNT}/${PING_FAIL_THRESHOLD})"
		if [ $PING_FAIL_COUNT -ge $PING_FAIL_THRESHOLD ]; then
			echo "Network confirmed down, restarting MQTT services..."
			PING_FAIL_COUNT=0
			kill_childs
		fi
	else
		PING_FAIL_COUNT=0

		if ! /usr/bin/pgrep -x tcpdump > /dev/null 2>&1; then
			echo "Starting MQTT sender..."
			/etc/tcpdump2mqtt/StartMqttSend &
			/bin/sleep 5
			/bin/date +"%Y-%m-%dT%H:%M:%S" | mpub -l -r -t "${TOPIC_STARTD}"
		fi

		if ! /usr/bin/pgrep -f "/etc/tcpdump2mqtt/StartMqttReceive" > /dev/null 2>&1; then
			echo "Starting MQTT receiver..."
			/etc/tcpdump2mqtt/StartMqttReceive &
			/bin/sleep 5
			mpub -r -t "${TOPIC_LASTWILL}" -m online
		fi

		if [ -x /etc/tcpdump2mqtt/keypress.sh ] && \
		   ! /usr/bin/pgrep -f "/etc/tcpdump2mqtt/keypress.sh" > /dev/null 2>&1; then
			/etc/tcpdump2mqtt/keypress.sh &
		fi
	fi

	/bin/sleep 30
done
